# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/etyme?schema=public"

# ── NextAuth ──────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generate: openssl rand -base64 32

# ── Microsoft OAuth ───────────────────────────────────
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# ── Google OAuth ──────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Claude API (parsing & matching) ──────────────────
ANTHROPIC_API_KEY=""

# ── File Storage (S3-compatible) ─────────────────────
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""  # For DigitalOcean Spaces: https://{region}.digitaloceanspaces.com

# ── DocuSign ──────────────────────────────────────────
DOCUSIGN_CLIENT_ID=""
DOCUSIGN_USER_ID=""
DOCUSIGN_PRIVATE_KEY=""
DOCUSIGN_ACCOUNT_ID=""
