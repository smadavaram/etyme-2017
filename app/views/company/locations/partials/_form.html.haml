.modal-body
  = form_for location, html: { class: 'form-horizontal', id: 'location' } do |location|
    %fieldset
      .form-group
        %label.col-md-2.control-label
          Location
          %sup.text-danger *
        .col-md-10
          = location.text_field :name, :placeholder => "Name", class: "form-control", :required => 'required', id: 'loc'
      = location.fields_for :address do |address|
        .form-group
          %label.col-md-2.control-label
            Address 1
          .col-md-10
            = address.text_field :address_1, :placeholder => "Address 1", class: "form-control", id: 'ad1'
        .form-group
          %label.col-md-2.control-label
            Address 2
          .col-md-10
            = address.text_field :address_2, :placeholder => "Address 2", class: "form-control", id: 'ad2'
        .form-group
          %label.col-md-2.control-label
            Country
            %sup.text-danger *
          .col-md-10
            = address.select :country, CS.countries.sort.map{|k,v| [v,k] }, {prompt: "Select Country"}, :class => "form-control", :required => 'required', onchange: " onSelectCountry();", id: 'country'
        .form-group
          %label.col-md-2.control-label
            State
          .col-md-10
            = address.select :state, location_state_options(address.object), {prompt: "Select State"}, class: "form-control", id: "state", onchange: " onSelectState();"
        .form-group
          %label.col-md-2.control-label
            City
          .col-md-10
            = address.select :city, location_city_options(address.object), {prompt: "Select City"}, class: "form-control", id: "city"
        .form-group
          %label.col-md-2.control-label
            Zip Code
          .col-md-10
            = address.text_field :zip_code, :placeholder => "Zip Code", class: "form-control"

    .modal-footer
      %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"}
        Cancel
      %button.btn.btn-primary{:type => "submit", id: 'form_id'}
        Submit
