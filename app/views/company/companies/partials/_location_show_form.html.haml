- locations = local_assigns[:locations] || current_company.locations.includes(:address)
.table-responsive
  %table#company_location_dataTable.table.text-center.table-bordered.table-lg.table-v2.table-striped
    %thead
      %tr{:role => "row"}
        %th{"data-hide" => "phone"} Name
        %th{"data-hide" => "phone,tablet"} Address
        %th Country
        %th State
        %th City
        %th{"data-hide" => "phone"} Zip Code
        %th{"data-hide" => "phone,tablet"} Actions
    %tbody
      - locations.each do |location|
        - next if location.new_record?
        - address = location.address
        %tr
          %td= location.name.presence || '--'
          %td= location_street_address(address)
          %td= location_country_name(address)
          %td= location_state_name(address)
          %td= location_city_name(address)
          %td= location_zip_code(address)
          %td
            = link_to raw("<i class='fa fa-edit'></i>"), edit_location_path(location), remote: true, class: 'btn btn-xs btn-default margin-bottom-5', 'data-toggle' => "tooltip", 'data-placement' => "top", title: 'Edit'
            = link_to raw("<i class='fa fa-times'></i>"), location_path(location), method: :delete, class: 'btn btn-xs btn-default btn-danger', title: 'Delete', data: { confirm: 'Are you sure you want to remove this location?' }
