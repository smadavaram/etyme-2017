// Etyme — data model
// Postgres + Prisma. Consolidates the 134 models of the 2017 application.
// Read alongside BUILD.md. Change this file before writing any application code.
//
// Phase 2 schema — replaces single Assignment with SellContract + BuyContract + ContractLink.
// Each company creates their own contracts. ContractLink joins buy↔sell within one company
// for profitability tracking. Adds Verification, Governance, Training, Visa document models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// IDENTITY  — a Person is permanent, credentials are replaceable,
// contexts are granted and revocable. Replaces 2017 candidate/user/admin/owner/consultant.
// ─────────────────────────────────────────────

model Person {
  id           String   @id @default(cuid())
  name         String
  primaryEmail String   @unique
  createdAt    DateTime @default(now())

  credentials            Credential[]
  contexts               Context[]
  consultant             ConsultantProfile?
  accessedBy             AccessLog[]            @relation("subject")
  actions                AccessLog[]            @relation("actor")
  visas                  VisaPetition[]
  submissions            Submission[]
  texts                  TextMessage[]
  sellContracts          SellContract[]
  // A person sits on a buy contract through a candidate line, because one
  // agreement can cover several people at their own rates.
  buyCandidacies         BuyContractCandidate[]
  timesheets             Timesheet[]
  invoiceLines           InvoiceLine[]
  matchOverrides         InvoiceMatchOverride[]
  verifications          Verification[]
  enrollments            Enrollment[]
  expenses               Expense[]
  requisitionsRaised     Requirement[]          @relation("requisitionRaiser")
  approvalRules          ApprovalRule[]         @relation("approvalRuleApprover")
  requirementApprovals   RequirementApproval[]  @relation("requirementApprover")
  documentSharesCreated  DocumentShare[]        @relation("shareCreator")
  documentSharesAbout    DocumentShare[]        @relation("shareSubject")
  managedContracts       SellContract[]         @relation("hiringManager") // Addendum E: contracts this person owns at the client
  eventsCaused           Event[]                @relation("eventActor")
  rulesAuthored          ApprovalRule[]         @relation("ruleAuthor")
  ruleVersions           ApprovalRuleVersion[]  @relation("ruleVersionAuthor")
  packetsCreated         DocumentPacket[]       @relation("packetCreator")
  packetsAbout           DocumentPacket[]       @relation("packetSubjectPerson")
  packetItemsReviewed    PacketItem[]           @relation("packetItemReviewer")
  serviceAccountsCreated ServiceAccount[]       @relation("serviceAccountCreator")
  customDomainsAdded     CustomDomain[]         @relation("customDomainAdder")
  representations        Representation[]
  doNotSubmit            DoNotSubmit[]
  resumes                Resume[]

  identityA IdentityMatch[] @relation("identityA")
  identityB IdentityMatch[] @relation("identityB")
}

model Credential {
  id         String    @id @default(cuid())
  personId   String
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  provider   Provider
  providerId String // subject claim from the IdP, or the email for magic links
  email      String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([provider, providerId])
  @@index([personId])
}

enum Provider {
  MICROSOFT
  GOOGLE
  EMAIL
  SAML
}

model Context {
  id          String      @id @default(cuid())
  personId    String
  person      Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  type        ContextType
  companyId   String?
  company     Company?    @relation(fields: [companyId], references: [id])
  roleId      String?
  role        Role?       @relation(fields: [roleId], references: [id])
  orgUnitId   String? // a delivery manager owns a practice, not the firm
  orgUnit     OrgUnit?    @relation(fields: [orgUnitId], references: [id])
  grantedById String?
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?

  // Access ends by default. Null means it genuinely does not — permitted
  // for read-only, argued for otherwise. Renewing is a click; forgetting is
  // safe, which is the opposite of how this normally works.
  expiresAt   DateTime?
  // Why this person has this. The reviewer in six months is rarely the
  // granter today, and "they asked" tells them nothing.
  grantReason String?
  // When they last did something this access was needed for. Null means
  // never — held but unused, which is exposure rather than access.
  lastUsedAt  DateTime?

  /// Paused, reversibly. Not a soft delete: this is for a leave of
  /// absence, a lapsed visa, an investigation — where the person is coming
  /// back and their history must stay attached to them. Using revocation
  /// for that loses the thread; using this for a leaver leaves a
  /// live-looking seat.
  suspendedAt   DateTime?
  suspendedById String?
  suspendReason String?

  /// Who ended it, and why. revokedAt alone says a seat closed; these say
  /// who decided and what they were thinking, which is the pair an audit
  /// asks for.
  revokedById  String?
  revokeReason String?

  /// Set when somebody was given a seat before ever signing in. Cleared on
  /// their first sign-in, so "invited" and "working" are never the same
  /// number reported upward.
  invitedAt   DateTime?
  invitedById String?

  @@index([companyId, suspendedAt])
  @@index([personId, revokedAt])
  @@index([companyId])
  @@index([companyId, expiresAt])
  /// editing a role reads everybody holding it
  @@index([roleId])
  @@index([orgUnitId])
}

enum ContextType {
  CONSULTANT
  EMPLOYEE
  PARTNER
  CLIENT_CONTACT
  PLATFORM_ADMIN
}

// One company acting for another (an MSP running a client programme).
// Deliberately not a ContextType — it has a validity window and a scope.
model Delegation {
  id        String    @id @default(cuid())
  grantorId String
  grantor   Company   @relation("grantor", fields: [grantorId], references: [id])
  granteeId String
  grantee   Company   @relation("grantee", fields: [granteeId], references: [id])
  scope     String[] // permission keys the grantee may exercise
  validFrom DateTime  @default(now())
  validTo   DateTime?
  revokedAt DateTime?

  @@index([granteeId, validTo])
  @@index([grantorId])
}

// Every read of a person's data, including refusals. The subject can see this.
model AccessLog {
  id             String   @id @default(cuid())
  subjectId      String
  subject        Person   @relation("subject", fields: [subjectId], references: [id], onDelete: Cascade)
  actorPersonId  String?
  actorPerson    Person?  @relation("actor", fields: [actorPersonId], references: [id])
  actorCompanyId String?
  actorCompany   Company? @relation(fields: [actorCompanyId], references: [id])
  action         String // PROFILE_VIEW · TALENT_VIEW_ANON · SUBMIT · MARKETING_REQUEST
  allowed        Boolean  @default(true)
  reason         String? // why it was refused
  at             DateTime @default(now())

  @@index([subjectId, at])
  @@index([actorPersonId])
  @@index([actorCompanyId])
}

// ─────────────────────────────────────────────
// ORGANISATION
// ─────────────────────────────────────────────

model Company {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique // {slug}.etyme.com — 2017 create_slug, collision numbered
  domain         String?     @unique
  domainVerified Boolean     @default(false) // true when it came from an OAuth tenant
  kind           CompanyKind
  entityType     String?

  /// Who here may see the market outside this company.
  ///
  /// ALLOWED for a staffing vendor, whose business is outside. NAMED_ONLY
  /// for a delivery firm or an enterprise, where a handful of people hire
  /// contractors and thirty thousand do not. CLOSED shuts it for everybody
  /// regardless of role, which is the setting an owner reaches for without
  /// wanting to audit every role in the company.
  outsideAccess String @default("NAMED_ONLY")

  /// Whether one client account here may see another.
  ///
  /// A delivery manager on one client's account has no business seeing who
  /// is staffed at another, at what rate, or rolling off when — that is the
  /// client's data rather than the firm's, and the contract usually says so.
  /// Expressed by attaching people to org units rather than by another
  /// permission: on a unit means that unit and everything under it, on no
  /// unit means the firm.
  accountWalls    Boolean @default(false)
  templatePack    String? // US_IT · US_SAP · IN_DELIVERY · UK
  // Where a supplier sits in the chain when they sign up: PRIME holds the
  // client agreement, BENCH sells through other suppliers. The same company
  // is often both — Infosys is prime to one client and buys bench from
  // three firms in the same week — so this shapes the first screens and can
  // be changed without migrating anything. Null for clients and MSPs.
  supplierPosture String?
  currency        String  @default("USD")
  // Where this company's people are already looking. When it is set,
  // business notifications post there; when it is not, they fall back to
  // email, and when there is no email either the notification says so
  // rather than sitting in the app pretending it was sent.
  teamsWebhookUrl String?

  /// The words on their public page.
  ///
  /// Written once at sign-up from what they actually are, and editable
  /// afterwards. Only the voice is stored — the facts on the page are read
  /// live from the same rows the dashboard reads, so nothing here can go
  /// out of date. A generated sentence about a company is a claim, and a
  /// claim that outlives its truth is worse than a plain page.
  siteTagline         String?
  siteIntro           String?
  /// Section names in their register rather than ours.
  siteHeadings        Json?
  /// MODEL or RULES, so a generated page is never mistaken for one
  /// somebody wrote.
  siteWrittenBy       String?
  siteWrittenAt       DateTime?
  // What this company does by default when no signed agreement says
  // otherwise. Sits under the master agreement in the cascade
  // (src/lib/billing-cascade.ts) and above the platform's own assumption.
  defaultPaymentTerms Int?
  /// Whether invoices to this company must quote a purchase order. Set at
  /// the company because it is an accounts-payable policy, not a
  /// per-supplier negotiation.
  poRequired          Boolean   @default(false)
  siteLiveAt          DateTime? // the ninety second promise
  networkVerifiedAt   DateTime? // visibility to other companies waits for this
  createdAt           DateTime  @default(now())

  contexts              Context[]
  roles                 Role[]
  orgUnits              OrgUnit[]
  entities              LegalEntity[]
  docTemplates          DocTemplate[]
  msasAsVendor          MasterAgreement[]       @relation("vendor")
  msasAsClient          MasterAgreement[]       @relation("client")
  requirements          Requirement[]
  invitationsOut        RequirementInvitation[] @relation("from")
  invitationsIn         RequirementInvitation[] @relation("to")
  benchListings         BenchListing[]
  submissionsOut        Submission[]            @relation("from")
  submissionsIn         Submission[]            @relation("to")
  automationLog         AutomationLog[]
  accessLogs            AccessLog[]
  delegationsOut        Delegation[]            @relation("grantor")
  delegationsIn         Delegation[]            @relation("grantee")
  partnersA             Partnership[]           @relation("a")
  partnersB             Partnership[]           @relation("b")
  // Contract relations — each company manages their own buy and sell contracts
  sellContractsOut      SellContract[]          @relation("sellVendor") // we sell talent
  sellContractsIn       SellContract[]          @relation("sellClient") // talent sold to us
  buyContractsOut       BuyContract[]           @relation("buyer") // we buy talent
  buyContractsIn        BuyContract[]           @relation("buyVendor") // talent bought from us
  // Compliance & governance
  verifications         Verification[]
  governancePolicies    GovernancePolicy[]
  // Training
  courses               Course[]
  // Expenses
  expenses              Expense[]
  // Conversations
  conversations         Conversation[]
  // Blacklist
  blacklists            Blacklist[]
  // Locations
  locations             CompanyLocation[]
  // Holidays
  holidays              Holiday[]
  // End-client contracts (where consultants actually work, when ≠ billing client)
  endClientContracts    SellContract[]          @relation("sellEndClient")
  endClientRequirements Requirement[]           @relation("requirementEndClient")
  payerRequirements     Requirement[]           @relation("requirementPayer")
  openings              Opening[]               @relation("openingOwner")
  openingsAsClient      Opening[]               @relation("openingClient")
  leads                 Lead[]                  @relation("leadOwner")
  leadsPosted           Lead[]                  @relation("leadPoster")
  resumesUploaded       Resume[]                @relation("resumeUploader")
  representationsHeld   Representation[]        @relation("representingVendor")
  representationsAt     Representation[]        @relation("representedAtClient")
  doNotSubmitTo         DoNotSubmit[]           @relation("doNotSubmitCompany")
  // Finance dimensions — owned per company, never shared across parties
  costCenters           CostCenter[]
  posIssued             PurchaseOrder[]         @relation("poIssuer")
  posReceived           PurchaseOrder[]         @relation("poRecipient")
  remitTos              RemitTo[]
  consultantsBehind     ConsultantProfile[]     @relation("consultantCorp")
  documentShares        DocumentShare[]
  approvalRules         ApprovalRule[]
  events                Event[]
  packets               DocumentPacket[]
  packetsAbout          DocumentPacket[]        @relation("packetSubjectCompany")
  serviceAccounts       ServiceAccount[]
  webhooks              WebhookSubscription[]
  subdomainAliases      SubdomainAlias[]
  customDomains         CustomDomain[]
  claimedDomains        CompanyDomain[]
  agentRuns             AgentRun[]
  checks                Check[]
  TextMessage           TextMessage[]

  // ── A demo company ─────────────────────────────────────────────────
  //
  // Every visitor who asks for a demo gets their own, seeded and
  // isolated, so they can break it freely without touching anybody
  // else's. Marked rather than inferred, because "looks like demo data"
  // is exactly the judgement nobody should be making about a customer's
  // real book.
  //
  // Reaped after a fortnight. A demo nobody came back to is clutter, and
  // a demo somebody is still using will have been extended by their
  // coming back.
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?

  // ── Companies that did not put themselves here ─────────────────────
  //
  // A client arrives with twelve suppliers already. Making each of them
  // sign up before the client can send them a role is asking the client
  // to do our selling for us, one phone call at a time — so the client
  // lists them, and each becomes a real company record that nobody has
  // taken possession of yet.
  //
  // An unclaimed shell can be sent a role and can be scored. It cannot
  // sign in, cannot be seen by the network, and must never be mistaken
  // for a firm that chose to be here.

  /// When somebody at this firm took possession of it. Null = a shell.
  claimedAt  DateTime?
  /// The client who put them on the platform, where that is how it began.
  listedById String?
  listedBy   Company?  @relation("listedSuppliers", fields: [listedById], references: [id])
  listed     Company[] @relation("listedSuppliers")

  supplierInvitesReceived SupplierInvite[] @relation("invitedCompany")
  supplierInvitesSent     SupplierInvite[] @relation("invitingCompany")

  interviewsHosted   Interview[] @relation("interviewHost")
  interviewsSupplied Interview[] @relation("interviewVendor")

  internalOrders InternalOrder[]

  ordersSold   SalesOrder[] @relation("orderSeller")
  ordersSoldTo SalesOrder[] @relation("orderSoldTo")
  ordersBillTo SalesOrder[] @relation("orderBillTo")
  ordersPayer  SalesOrder[] @relation("orderPayer")

  invoicesSoldTo Invoice[]       @relation("invoiceSoldTo")
  invoicesBillTo Invoice[]       @relation("invoiceBillTo")
  invoicesPayer  Invoice[]       @relation("invoicePayer")
  IdentityMatch  IdentityMatch[]
  WorkAssertion  WorkAssertion[]

  @@index([listedById])
}

/// Where a submission actually gets decided.
///
/// Every ATS treats an interview as a thing a client books. In contract
/// staffing it is not: the client proposes, the vendor has to know their
/// consultant is free and still interested, and the consultant has to
/// turn up. Three diaries, and the one that breaks is almost never the
/// client's — so nothing is confirmed until all three have said so.
model Interview {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// The company running it — the one that received the submission.
  companyId String
  company   Company @relation("interviewHost", fields: [companyId], references: [id], onDelete: Cascade)
  /// The supplier who put the person forward.
  vendorId  String
  vendor    Company @relation("interviewVendor", fields: [vendorId], references: [id])

  round Int    @default(1)
  /// SCREEN · TECHNICAL · FINAL — the client's own words, not an enum.
  stage String @default("TECHNICAL")
  /// PHONE · VIDEO · ONSITE
  mode  String @default("VIDEO")
  /// PROPOSED · CONFIRMED · DONE · NO_SHOW · CANCELLED
  state String @default("PROPOSED")

  /// [{ start, end }] in UTC. Displayed local, stored absolute — an
  /// interview booked across two time zones is the ordinary case.
  proposedSlots Json
  proposedAt    DateTime  @default(now())
  scheduledAt   DateTime?
  durationMins  Int       @default(60)
  /// A link, or an address. One field, because it is one answer to one
  /// question: where do I go.
  location      String?

  /// Who asked for it.
  requestedById String
  /// Names, not seats. Plenty of interviewers have no account here.
  interviewers  String[]

  clientConfirmedAt      DateTime?
  vendorConfirmedAt      DateTime?
  consultantConfirmedAt  DateTime?
  /// SELF · VENDOR_ASSERTED — the same convention as the right to
  /// represent. A consultant with no seat here is confirmed by their
  /// vendor, and the difference matters when nobody turns up.
  consultantConfirmedVia String?

  /// ADVANCE · OFFER · REJECT
  outcome     String?
  feedback    String?
  /// CLIENT · VENDOR · CONSULTANT
  noShowBy    String?
  decidedAt   DateTime?
  decidedById String?

  cancelledAt     DateTime?
  cancelledReason String?

  createdAt DateTime @default(now())

  @@unique([submissionId, round])
  @@index([companyId, state])
  @@index([vendorId, state])
  @@index([submissionId])
}

/// The commercial terms for one engagement, separate from the people on it.
///
/// A contract says what one person costs. A sales order says how the work
/// is billed: on a schedule or on delivery, at what ceiling, to whom, and
/// how long the client has to approve a timesheet before silence counts.
///
/// Five contractors on one project is five contracts and one order. The
/// order is what the invoice references and what a finance team recognises
/// — and putting its terms on each contract instead means five places to
/// change a payment term and four of them get missed.
model SalesOrder {
  id        String  @id @default(cuid())
  /// The vendor selling.
  companyId String
  company   Company @relation("orderSeller", fields: [companyId], references: [id], onDelete: Cascade)

  engagementId String?
  engagement   Engagement?      @relation(fields: [engagementId], references: [id])
  msaId        String?
  msa          MasterAgreement? @relation(fields: [msaId], references: [id])

  /// Their own reference — the number the client's AP team will quote.
  number String
  title  String

  // ── Who is who ─────────────────────────────────────────────────────
  //
  // A large client signs in one entity, is billed through a shared
  // services centre in another country, has the work done at a third
  // site, and pays from a fourth. On the order because that is where the
  // commercial relationship is agreed, and the invoice inherits it.

  /// Who signed. Always present — somebody agreed to this.
  soldToId String
  soldTo   Company          @relation("orderSoldTo", fields: [soldToId], references: [id])
  /// Where invoices go. Null = the sold-to.
  billToId String?
  billTo   Company?         @relation("orderBillTo", fields: [billToId], references: [id])
  /// Where the work happens. Null = wherever each contract says.
  shipToId String?
  shipTo   CompanyLocation? @relation("orderShipTo", fields: [shipToId], references: [id])
  /// Who settles. Null = the bill-to.
  payerId  String?
  payer    Company?         @relation("orderPayer", fields: [payerId], references: [id])

  // ── How it is billed ───────────────────────────────────────────────

  /// TIME · MILESTONE · BOTH — a project with a monthly retainer and
  /// three delivery payments is ordinary, so both is a real answer.
  billingBasis  String @default("TIME")
  /// WEEKLY · BIWEEKLY · SEMIMONTHLY · MONTHLY · CUSTOM
  billFrequency String @default("MONTHLY")
  /// CALENDAR · CONTRACT_START · CUSTOM — where the period begins.
  billAnchor    String @default("CALENDAR")
  /// SPLIT · TO_EARLIER · TO_LATER — a week crossing a month end.
  billStraddle  String @default("SPLIT")
  /// Explicit dates, where the frequency is CUSTOM.
  customDates   Json?

  /// NET days. Cascades from the MSA, overridable here.
  paymentTerms Int    @default(30)
  currency     String @default("USD")
  /// What the order may bill in total, cents. Null = uncapped.
  ceilingCents Int?

  // ── Approving the hours ────────────────────────────────────────────

  /// Whether silence counts as approval after the window below.
  autoApproveTimesheets Boolean @default(false)
  /// Working days the client has before it does. Null = the default.
  approvalWindowDays    Int?

  status    String    @default("DRAFT") // DRAFT · OPEN · CLOSED · CANCELLED
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  milestones    OrderMilestone[]
  sellContracts SellContract[]
  invoices      Invoice[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([soldToId])
  @@index([billToId])
  @@index([shipToId])
  @@index([payerId])
  @@index([engagementId])
  @@index([msaId])
}

/// A payment that falls due on delivery rather than on a date.
///
/// Kept separate from the order's schedule because the two coexist: a
/// project can carry a monthly retainer and three delivery payments, and
/// flattening them into one list loses which is which when somebody asks
/// why an invoice is larger this month.
model OrderMilestone {
  id      String     @id @default(cuid())
  orderId String
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  name         String
  amountCents  Int
  /// When it is expected. Not when it becomes billable — that is
  /// `acceptedAt`, and the gap between the two is the interesting part.
  dueOn        DateTime?
  /// The client agreeing the thing was delivered. Until this, no invoice.
  acceptedAt   DateTime?
  acceptedById String?
  /// Said plainly where it slipped or was reduced.
  note         String?
  status       String    @default("PENDING") // PENDING · ACCEPTED · INVOICED · CANCELLED
  sortOrder    Int       @default(0)

  createdAt DateTime @default(now())

  @@index([orderId, status])
}

/// Two records that might be one human, and what somebody decided.
///
/// A client and a bench vendor both on the platform with the prime
/// between them offline means the same person arrives twice under two
/// Person rows, and the tenure ledger counts fourteen months and twelve
/// as two people.
///
/// The decision is recorded rather than the merge performed. Merging two
/// different contractors blocks one on a cap they never earned and pays
/// the other at somebody else's rate — so the rows stay separate and a
/// confirmed link is read by anything that aggregates.
model IdentityMatch {
  id String @id @default(cuid())

  /// Whose view this is. Identity resolution never reaches outside the
  /// company asking — a client is shown two people already in their own
  /// records, never somebody they have not been shown.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Ordered so a pair is stored once whichever way round it is found.
  personAId String
  personA   Person @relation("identityA", fields: [personAId], references: [id], onDelete: Cascade)
  personBId String
  personB   Person @relation("identityB", fields: [personBId], references: [id], onDelete: Cascade)

  /// CERTAIN · LIKELY · POSSIBLE
  confidence   String
  score        Int
  /// What it read to decide, so a person can argue with it.
  signals      Json
  /// Their combined tenure here if this is one person.
  monthsIfSame Int

  /// SUGGESTED · CONFIRMED · DISMISSED
  state       String    @default("SUGGESTED")
  decidedById String?
  decidedAt   DateTime?
  /// Why somebody said no, which is the useful half.
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, personAId, personBId])
  @@index([companyId, state])
  @@index([personAId])
  @@index([personBId])
}

/// One company's position on some or all of a timesheet.
///
/// Hours are a fact; approvals are opinions about that fact. 2017 kept
/// the two together by duplicating the whole timesheet down the chain,
/// so three companies meant three copies of one week and "is this
/// approved" had three answers. Two signature columns collapsed it the
/// other way — right for two parties, silently wrong for three.
///
/// A list of assertions works at any depth, carries each leg's own rate,
/// covers a date range so partial approval is ordinary rather than
/// exceptional, and is its own audit trail: nothing is ever edited, so
/// the rows in order are the history.
model WorkAssertion {
  id String @id @default(cuid())

  /// The hours being asserted about. Never edited by this.
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  /// Who is speaking. A company may only speak for its own leg.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// CLIENT_APPROVAL · PASS_THROUGH · EMPLOYER_ACCEPTANCE
  role String

  /// Inclusive dates. Both null covers the whole timesheet.
  coversFrom DateTime?
  coversTo   DateTime?

  /// What this company accepts across the range it covers.
  hours     Decimal @db.Decimal(7, 2)
  /// Their rate for this leg. Their money, their number.
  rateCents Int

  /// LIVE · WITHDRAWN · SUPERSEDED. Rows are never deleted or updated
  /// in place except to move to one of the latter two.
  state String @default("LIVE")

  at   DateTime @default(now())
  /// Null where nobody looked — an automatic approval names nobody,
  /// because one carrying a manager's id is a forged signature.
  byId String?
  auto Boolean  @default(false)
  note String?

  /// The assertion this replaces, where it replaces one.
  supersedesId String?        @unique
  supersedes   WorkAssertion? @relation("supersedes", fields: [supersedesId], references: [id])
  supersededBy WorkAssertion? @relation("supersedes")

  @@index([timesheetId, state])
  @@index([companyId, role, state])
}

/// An invitation to a firm that has never heard of us.
///
/// Distinct from `RequirementInvitation`, which invites a company already
/// here to bid on one role. This one invites the company itself, and it
/// carries the only thing that lets somebody claim a supplier record.
model SupplierInvite {
  id        String  @id @default(cuid())
  /// The supplier shell this invitation is for.
  companyId String
  company   Company @relation("invitedCompany", fields: [companyId], references: [id], onDelete: Cascade)
  /// The client doing the inviting.
  byId      String
  by        Company @relation("invitingCompany", fields: [byId], references: [id], onDelete: Cascade)

  email       String
  contactName String?
  /// The registrable part of the address, or null for a consumer one.
  ///
  /// Kept here rather than on the shell company, because `Company.domain`
  /// is globally unique and a shell has not proved it owns anything. A
  /// client pasting "cloudepa.com" must not be able to take the domain
  /// away from the real Cloudepa, or be handed it.
  domain      String?
  /// What was pasted, kept whole so a better reader can be run later.
  line        String?

  /// The claim. Single use, and the only authority besides the address.
  token        String    @unique
  state        String    @default("PENDING") // PENDING · ACCEPTED · REVOKED
  sentAt       DateTime  @default(now())
  remindedAt   DateTime?
  acceptedAt   DateTime?
  acceptedById String?

  @@unique([byId, email])
  @@index([companyId, state])
  @@index([byId, state])
  @@index([byId, domain])
}

enum CompanyKind {
  VENDOR
  CLIENT
  MSP
  GSI
  // A consultant's own limited company, on corp-to-corp work. It is a real
  // company — it signs, invoices and carries insurance — but it does not
  // recruit, so it never appears in vendor lists or requirement
  // distribution.
  CONSULTANT_CORP
}

// Work sites / offices for a company. Clients have locations where consultants work;
// vendors have offices where recruiters sit. A SellContract's workLocation pins where
// the consultant physically works — required for compliance (LCA amendments, state tax,
// work-rights checks on cross-border moves per BRD Addendum C §C2.2 step 5).
model CompanyLocation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String // "Lakewood HQ", "Tokyo R&D", "Remote"
  address   String?
  city      String?
  state     String? // US state or region
  country   String  @default("US")
  isRemote  Boolean @default(false) // virtual location for remote-first work
  isPrimary Boolean @default(false) // the default location for this company

  sellContracts SellContract[] // contracts at this work site

  invoicesShipTo Invoice[]    @relation("invoiceShipTo")
  ordersShipTo   SalesOrder[] @relation("orderShipTo")

  @@index([companyId])
}

// Infosys India and Infosys US: one Company, two employers.
model LegalEntity {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  country      String
  currency     String
  buyContracts BuyContract[] // payroll runs through the legal entity

  @@index([companyId])
}

// Business unit → practice → account → project. Scopes utilization and authority.
model OrgUnit {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        OrgUnit?       @relation("tree", fields: [parentId], references: [id])
  children      OrgUnit[]      @relation("tree")
  name          String
  kind          String // BU · PRACTICE · ACCOUNT · PROJECT · DEPARTMENT
  contexts      Context[]
  sellContracts SellContract[] // contingent workers charged to this unit
  deliveredHere SellContract[] @relation("deliveryUnit") // accounts this unit delivers
  costCenters   CostCenter[] // budgets that fund this unit
  requisitions  Requirement[]
  approvalRules ApprovalRule[]

  internalOrders InternalOrder[]

  @@index([companyId])
  @@index([parentId])
}

model Role {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  permissions String[] // see PERMISSIONS in BUILD.md
  isDefault   Boolean   @default(false)
  contexts    Context[]

  @@index([companyId])
}

model Partnership {
  id        String   @id @default(cuid())
  aId       String
  a         Company  @relation("a", fields: [aId], references: [id])
  bId       String
  b         Company  @relation("b", fields: [bId], references: [id])
  status    String // PENDING · ACCEPTED · BLOCKED
  createdAt DateTime @default(now())

  @@unique([aId, bId])
}

// ─────────────────────────────────────────────
// SUPPLY
// ─────────────────────────────────────────────

model ConsultantProfile {
  id           String   @id @default(cuid())
  personId     String   @unique
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  headline     String?
  skills       String[]
  location     String?
  workAuth     String?
  // On corp-to-corp, the company the consultant works through. This is the
  // entity that must carry general liability and workers' compensation —
  // not the staffing vendor — so without it the insurance check is looking
  // at the wrong company.
  ownCompanyId String?
  ownCompany   Company? @relation("consultantCorp", fields: [ownCompanyId], references: [id]) // US_CITIZEN · GC · H1B · OPT · GBP_SW · null
  rateFloor    Int? // the consultant sets this; no listing may go below it

  /// Their own address, and their own page.
  ///
  /// A consultant had no public presence at all. Every agency they work
  /// through has a page; the person doing the work had nothing, which is
  /// backwards in a market where the person is the product.
  ///
  /// It belongs to them rather than to whichever agency currently
  /// represents them, and it travels — that is the whole point. Null until
  /// they ask for one, because a page nobody chose is a page nobody
  /// maintains.
  slug String? @unique

  /// Addresses they used before.
  ///
  /// Changing an address has to keep the old links working, or a portfolio
  /// somebody put on a CV two years ago becomes a dead page. The old one is
  /// held here forever: never reissued to anybody else, and redirected to
  /// wherever they are now.
  previousSlugs String[] @default([])

  // ── How fresh any of this actually is ──────────────────────────────
  //
  // A bench record says somebody is free at $78 and knows Java. That was
  // true three weeks ago. Since then they took a contract, raised their
  // rate, or learned Kubernetes, and nobody updated the record because
  // updating records is nobody's job.
  //
  // Every clever thing in this product sits on top of this record. If it
  // is wrong, the scoring produces confident nonsense faster than a human
  // could produce it slowly. So: when the person themselves last said it
  // was right, and how they said so.
  //
  // Unconfirmed is never a reason to hide somebody — that would empty the
  // bench on day one. It moves them down the ranking, and it is said out
  // loud rather than assumed away.

  /// When the consultant last confirmed their own availability and rate.
  confirmedAt  DateTime?
  /// SMS · EMAIL · PORTAL — how the confirmation arrived.
  confirmedVia String?
  /// When they were last asked. Two asks with no reply is information too.
  askedAt      DateTime?
  /// Consecutive asks with no answer. Reset by any reply.
  unanswered   Int       @default(0)
  /// Their mobile, for the three texts. Null means email only.
  mobile       String?
  /// Set when they reply STOP. Nothing is ever sent again.
  textsOffAt   DateTime?

  /// When they turned the page on, and null until they do.
  ///
  /// Deliberately not `visibility`. That field says whether an agency may
  /// show them to clients inside the platform, it is usually set by the
  /// agency, and it is not consent to be named on the open internet.
  /// Conflating the two would have published people who agreed to a bench
  /// listing and nothing more.
  pageLiveAt DateTime?

  /// The words on it. Same rule as a company: written from what they have
  /// actually done, editable, and never covering the facts.
  bioHeadline   String?
  bioIntro      String?
  bioWrittenBy  String?
  availableFrom DateTime?
  visibility    Visibility     @default(INTERNAL) // progressive enrichment, never a hard gate
  listings      BenchListing[]
  matches       Match[]

  @@index([ownCompanyId])
}

enum Visibility {
  INTERNAL
  FEED
  CLIENT_VISIBLE
  VERIFIED
}

// A consultant may appear on several marketing benches, one retained bench.
model BenchListing {
  id           String            @id @default(cuid())
  consultantId String
  consultant   ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tier         BenchTier
  rateMin      Int?
  rateMax      Int?
  grantedAt    DateTime          @default(now()) // by the consultant, not the company
  revokedAt    DateTime?

  /// Whether they agree to be shown before their current contract ends.
  ///
  /// Separate from the listing itself, because being sold two weeks before
  /// you finish is a different thing from being on a bench list, and a
  /// person may reasonably want one and not the other. Defaults to on —
  /// somebody granting a listing while on assignment is agreeing to be
  /// placed, and asking twice for the same permission is friction — but
  /// they can say no without withdrawing the listing.
  showBeforeFree Boolean @default(true)

  /// Whether this company must ask before putting them in front of a client.
  ///
  /// Off by default: somebody who grants a bench listing is asking to be
  /// marketed, and making every submission wait on a reply would send the
  /// vendor back to email. On, it turns each new client into a question the
  /// person answers — which is what somebody with a current client to
  /// protect, or one bad experience behind them, will want.
  askFirst Boolean @default(false)

  @@unique([consultantId, companyId])
  @@index([companyId, revokedAt])
}

enum BenchTier {
  RETAINED
  MARKETING
}

model VisaPetition {
  id         String         @id @default(cuid())
  personId   String
  person     Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  type       String // H1B · L1 · GC · TN · SKILLED_WORKER
  country    String
  status     String // FILED · RFE · APPROVED · STAMPED · ACTIVE · EXPIRING · EXPIRED
  filedAt    DateTime?
  approvedAt DateTime?
  expiresAt  DateTime?
  transferOk Boolean        @default(false)
  documents  VisaDocument[]
  events     VisaEvent[]

  @@index([personId, status])
}

// Supporting documents for a visa petition (I-797, EAD card, passport, etc.)
model VisaDocument {
  id         String       @id @default(cuid())
  petitionId String
  petition   VisaPetition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  docType    String // I797 · EAD · PASSPORT · VISA_STAMP · OFFER_LETTER · LCA · I94
  fileName   String
  fileUrl    String
  expiresAt  DateTime?
  uploadedAt DateTime     @default(now())

  @@index([petitionId])
}

// Status change events for a visa petition (filed, RFE issued, approved, etc.)
model VisaEvent {
  id         String       @id @default(cuid())
  petitionId String
  petition   VisaPetition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  eventType  String // FILED · RECEIVED · RFE_ISSUED · RFE_RESPONDED · APPROVED · DENIED · STAMPED · TRANSFER_FILED
  occurredAt DateTime
  notes      String?
  createdAt  DateTime     @default(now())

  @@index([petitionId, occurredAt])
}

// ─────────────────────────────────────────────
// DEMAND
// ─────────────────────────────────────────────

model MasterAgreement {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Company   @relation("vendor", fields: [vendorId], references: [id])
  clientId     String
  client       Company   @relation("client", fields: [clientId], references: [id])
  paymentTerms Int       @default(30)
  currency     String    @default("USD")
  /// When it was actually signed. Null means work is running on a
  /// handshake — which is the ordinary state of this industry between an
  /// offer and a start date, and worth being able to count rather than
  /// pretend away.
  signedAt     DateTime?
  minMarginPct Int? // the floor a recruiter may not price below without approval
  rateCard     Json? // condition records: client + skill + level + location
  capacity     Int? // max resources for GSA global contracts (null = unlimited)
  createdAt    DateTime  @default(now())

  engagements   Engagement[]
  requirements  Requirement[]
  sellContracts SellContract[]
  salesOrders   SalesOrder[]

  @@index([vendorId])
  @@index([clientId])
}

model Requirement {
  id          String           @id @default(cuid())
  companyId   String // whoever owns the demand
  company     Company          @relation(fields: [companyId], references: [id])
  msaId       String?
  msa         MasterAgreement? @relation(fields: [msaId], references: [id])
  title       String
  skills      String[]
  location    String?
  billMin     Int?
  billMax     Int?
  months      Int?
  startDate   DateTime?
  status      String           @default("OPEN") // DRAFT · OPEN · FILLED · CLOSED
  source      String           @default("MANUAL") // MANUAL · EMAIL · VMS · NETWORK
  parseConf   Json? // per field confidence when it came from a parser
  // Addendum D: rate transparency per requirement
  marginClass String? // ARBITRAGE · EXPERTISE — distinguishes opacity-based vs capability-based margin
  rateVisible Boolean          @default(false) // vendor rate visibility setting, inherited by contracts

  /// Whether any supplier may see this, or only the ones invited.
  ///
  /// Invite-only by default, because a client's hiring plan is commercially
  /// sensitive and publishing it should be a decision rather than a
  /// surprise. Set true and it appears on the company's public page, where
  /// a supplier they have never met can find it — which is how the demand
  /// side pulls the supply side in.
  ///
  /// Rates are never published with it. What each supplier may charge lives
  /// on RequirementInvitation precisely so no recipient reads another's
  /// band, and a public page is the most public recipient there is.
  openToNetwork Boolean @default(false)

  /// Where the work actually is, when it is not the company posting it.
  ///
  /// An MSP or a prime posts a requirement for somebody else's site. Two
  /// primes feeding the same end client is exactly the case where the same
  /// consultant gets submitted twice and loses the role, so the hold has to
  /// key on the end client where it is known.
  endClientCompanyId String?
  endClientCompany   Company? @relation("requirementEndClient", fields: [endClientCompanyId], references: [id])

  /// Whether an invited supplier may be told which end client this is for.
  ///
  /// Off by default. A prime putting work out to sub-vendors is telling
  /// them what to staff, not who they are staffing for — naming the client
  /// hands a supplier the relationship, and hands a competitor the account.
  /// The same reasoning as rateVisible, one field over.
  endClientVisible Boolean @default(false)

  /// Who this role is worked through — the prime who posted it, or the
  /// client direct.
  ///
  /// Null on a client's own requisition: they are the recipient. On a
  /// vendor's record of somebody else's advert it is the party the
  /// candidate is actually submitted to, and therefore the party who gets
  /// the invoice.
  ///
  /// Without it a vendor submitting against their own record submitted to
  /// themselves, and the award produced a contract where they sold to
  /// themselves — no counterparty, no approver, nothing to bill.
  payerCompanyId String?
  payerCompany   Company? @relation("requirementPayer", fields: [payerCompanyId], references: [id])

  /// The role this was mirrored from, one hop down the chain.
  ///
  /// A prime forwarding a candidate to their client needs the client to
  /// have a record of the role, because a submission is unique on
  /// (requirement, person) and reusing the sender's row would collide with
  /// the rule that stops one name reaching a client twice. 2017 called
  /// these sub-jobs and pointed them at a parent.
  mirroredFromId String?
  mirroredFrom   Requirement?  @relation("mirror", fields: [mirroredFromId], references: [id])
  mirrors        Requirement[] @relation("mirror")

  /// The seat this is a working record of.
  ///
  /// A requirement is what a vendor writes down about a role they are
  /// working. The opening is the seat itself, which several requirements —
  /// and several primes — may point at.
  openingId String?
  opening   Opening? @relation(fields: [openingId], references: [id])

  // ── Demand side (Addendum E) ──
  // A requisition raised by the client, as opposed to a requirement a vendor
  // records against demand it heard about. Same object, two origins: the
  // client names the budget, the manager and the headcount; the vendor sees
  // it with a rate band that is theirs alone (on RequirementInvitation).
  raisedById      String? // the hiring manager who needs the people
  raisedBy        Person?        @relation("requisitionRaiser", fields: [raisedById], references: [id])
  orgUnitId       String? // the department the headcount belongs to
  orgUnit         OrgUnit?       @relation(fields: [orgUnitId], references: [id])
  internalOrderId String?
  internalOrder   InternalOrder? @relation(fields: [internalOrderId], references: [id])
  costCenterId    String? // the budget that funds it
  costCenter      CostCenter?    @relation(fields: [costCenterId], references: [id])
  headcount       Int            @default(1) // "I need three of these", not three requisitions
  neededBy        DateTime?

  /// The work authorisation this role actually requires.
  ///
  /// Null means the role does not care, which is the honest default —
  /// inventing a requirement here would hold back half the market on a
  /// rule nobody set. Where a client does set it, it is the single
  /// cheapest thing to check and the most expensive to discover in week
  /// two of an assignment.
  workAuthRequired String?
  justification    String?

  // Approval is separate from status: a requisition can be APPROVED and still
  // OPEN, or PENDING and never reach the market. Addendum E: most clear
  // without a human, because governance slower than the workaround produces
  // the workaround.
  approvalState String @default("DRAFT") // DRAFT · PENDING_APPROVAL · APPROVED · REJECTED · AUTO_APPROVED

  approvals  RequirementApproval[]
  placements SellContract[]

  createdAt DateTime @default(now())

  invitations     RequirementInvitation[]
  matches         Match[]
  submissions     Submission[]
  representations Representation[]

  /// How much of this role is going to go wrong, out of a hundred.
  ///
  /// Not a grade on whoever wrote it. A shorthand for "will this be
  /// filled", and only ever shown next to the reasons — a number alone
  /// tells nobody what to change.
  ///
  /// Null until the check has been run once.
  qualityScore Int?

  /// How many times the quality check has run.
  ///
  /// A real counter, because the attempt was derived from whether
  /// qualityScore was null — so it read 1, then 2, then 2 forever. Fix
  /// the role, re-check, and it still said "still wrong after 2 tries".
  /// The cap was decoration.
  qualityAttempt Int @default(0)

  @@index([companyId, status])
  @@index([openToNetwork, status])
  @@index([msaId])
  @@index([raisedById])
  @@index([orgUnitId])
  @@index([costCenterId])
  @@index([endClientCompanyId])
  @@index([openingId])
  @@index([mirroredFromId])
  @@index([payerCompanyId])
  @@index([internalOrderId])
}

// ─────────────────────────────────────────────
// DEMAND-SIDE GOVERNANCE (Addendum E)
//
// "Most requisitions must clear without human approval. Governance slower
//  than the workaround produces the workaround."
//
// So these exist to let a requisition clear ITSELF where the facts allow,
// and to route it to a named person only where they do not.
// ─────────────────────────────────────────────

// How many people a cost centre is approved to run, and for how much.
// Without this, "is there budget for this requisition?" has no answer and
// every request has to go to a human.
model HeadcountPlan {
  id            String     @id @default(cuid())
  costCenterId  String
  costCenter    CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  period        String // "2026" or "2026-Q3"
  approvedHeads Int // positions the plan allows
  annualBudget  Decimal    @db.Decimal(12, 2) // authorised spend for the period
  currency      String     @default("USD")
  createdAt     DateTime   @default(now())

  @@unique([costCenterId, period])
  @@index([period])
}

// Who may approve what, at a client. Thresholds are the delegation of
// authority: below them a requisition clears itself.
/// What an approval rule used to say.
///
/// A rule is not a setting; it is a control, and a control that can be
/// changed without trace is not one. The question an auditor asks is what
/// the chain looked like in March, and the current row cannot answer it.
///
/// Written on every change, including the first. Nothing here is ever
/// updated — a correction is another row.
model ApprovalRuleVersion {
  id     String       @id @default(cuid())
  ruleId String
  rule   ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  /// What it said at this point.
  name            String
  thresholdAmount Decimal? @db.Decimal(12, 2)
  approverIds     String[]
  orgUnitId       String?
  isActive        Boolean

  /// CREATED · CHANGED · DEACTIVATED — what kind of moment this was.
  action      String
  changedById String
  changedBy   Person   @relation("ruleVersionAuthor", fields: [changedById], references: [id])
  /// Why. A rule change with no reason is the one an auditor stops on.
  reason      String?
  /// Warnings accepted at the time, so "they were told" is a fact rather
  /// than a recollection.
  notes       String[]
  changedAt   DateTime @default(now())

  @@index([ruleId, changedAt])
  @@index([changedById])
}

model ApprovalRule {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String // "Departmental — up to $250k"
  // A requisition needs this rule when its annualised value exceeds the
  // threshold, or it breaches plan or band. Null means always applies.
  thresholdAmount Decimal? @db.Decimal(12, 2)
  approverId      String
  approver        Person   @relation("approvalRuleApprover", fields: [approverId], references: [id])
  orgUnitId       String? // scope to a department; null = company-wide
  orgUnit         OrgUnit? @relation(fields: [orgUnitId], references: [id])
  rank            Int      @default(1) // ascending: rank 1 approves before rank 2
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  /// Who wrote it. Needed to refuse a rule whose only approver is its
  /// author — the same control already applied to rate rises.
  authoredById String?
  authoredBy   Person? @relation("ruleAuthor", fields: [authoredById], references: [id])

  versions ApprovalRuleVersion[]

  @@index([companyId, isActive])
  /// "what am I being asked to approve" is the approver's first question
  @@index([approverId])
  @@index([orgUnitId])
  @@index([authoredById])
}

// One approval decision on one requisition. Auto-clearances are recorded
// here too, with the reason — an auto-approved requisition is not an
// unreviewed one, it is one where the review was executed by rule.
model RequirementApproval {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  approverId    String? // null when cleared by rule rather than a person
  approver      Person?     @relation("requirementApprover", fields: [approverId], references: [id])
  rank          Int         @default(1)
  outcome       String // PENDING · APPROVED · REJECTED · AUTO_CLEARED
  reason        String // plain English, always present
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([requirementId, outcome])
  @@index([approverId, outcome])
}

// The rate band lives here, not on the requirement. Every recipient may see a different one.
model RequirementInvitation {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fromCompanyId String
  fromCompany   Company     @relation("from", fields: [fromCompanyId], references: [id])
  toCompanyId   String
  toCompany     Company     @relation("to", fields: [toCompanyId], references: [id])
  payMin        Int?
  payMax        Int?
  message       String?
  expiresAt     DateTime
  status        String      @default("SENT") // SENT · ACCEPTED · DECLINED · EXPIRED
  createdAt     DateTime    @default(now())

  @@unique([requirementId, toCompanyId])
  @@index([toCompanyId, status])
  @@index([fromCompanyId])
}

// Computed, disposable, carries its own reasoning. Never confused with a Submission.
model Match {
  id            String            @id @default(cuid())
  requirementId String
  requirement   Requirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  consultantId  String
  consultant    ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  score         Int
  confidence    String // HIGH · MODERATE · LOW
  factors       Json // [{ label, value, weight }] — shown in the UI, not hidden
  basis         String // "34 BRIM placements over 18 months"
  unknowns      String? // what it could not account for
  computedAt    DateTime          @default(now())

  @@unique([requirementId, consultantId])
}

// One record, two views. Sent for the origin, received for the destination.
model Submission {
  id            String         @id @default(cuid())
  requirementId String
  requirement   Requirement    @relation(fields: [requirementId], references: [id])
  personId      String
  person        Person         @relation(fields: [personId], references: [id])
  fromCompanyId String
  fromCompany   Company        @relation("from", fields: [fromCompanyId], references: [id])
  toCompanyId   String
  toCompany     Company        @relation("to", fields: [toCompanyId], references: [id])
  kind          SubmissionKind
  rate          Int
  // How the vendor engages this person: W2 of the vendor, corp-to-corp with
  // their own company, or 1099 as a sole trader.
  //
  // The vendor declares it because only they know it. The client cannot see
  // it any other way, and the difference matters: a 1099 sole trader carries
  // far more co-employment risk for the client than a consultant working
  // through their own corporation.
  //
  // Null on submissions made before this existed.
  contractType  ContractType?
  status        String         @default("SUBMITTED")
  submittedAt   DateTime       @default(now()) // first timestamp wins on a duplicate

  /// The CV that actually went with this submission.
  ///
  /// The version, not the person's current one. A client acted on the
  /// document they were sent, and a consultant who rewrites their CV next
  /// month does not retroactively change what a client read.
  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id])

  // ── How it ended, and why ──────────────────────────────────────────
  //
  // `status` says where it got to. This says why it stopped, and it is the
  // only thing here that compounds: every feature in this product can be
  // rebuilt by somebody else in a quarter, and twelve months of real
  // rejection reasons across a vendor chain cannot be bought at any price.
  //
  // A closed list, because free text is what a recruiter types at eight at
  // night and nobody can count afterwards.

  /// RATE · SKILLS · WORK_AUTH · AVAILABILITY · INTERVIEW · TIMING ·
  /// CANDIDATE_WITHDREW · NO_REPLY
  rejectReason String?
  /// What they actually said, where somebody bothered to write it down.
  rejectNote   String?
  rejectedAt   DateTime?

  // ── The check loop ─────────────────────────────────────────────────
  //
  // Deliberately not `status`. That field is the pipeline — submitted,
  // shortlisted, placed — and it belongs to the client's decision. This
  // one is ours: whether the package is fit to leave the building.
  //
  // Modelled as a field rather than a running process, so each call moves
  // it exactly one step and a crash halfway leaves a record somebody can
  // look at instead of a job nobody can find.

  /// DRAFT · CHECKING · NEEDS_FIX · READY · SENT
  checkState String @default("DRAFT")

  // ── The screen, from the other side ────────────────────────────────
  //
  // `checkState` is the sender's: is this package fit to leave. This one
  // is the recipient's: is it worth the hiring manager's afternoon. They
  // are different questions with different answers — a package can be
  // perfectly assembled and still be the fourth vendor to send the same
  // person at the highest rate.
  //
  // Two fields rather than reusing the sender's, because the sender must
  // never be able to mark their own submission as having cleared the
  // buyer's screen.

  interviews Interview[]

  /// DRAFT · NEEDS_FIX · READY — READY means it reaches the manager.
  screenState    String    @default("DRAFT")
  /// Two, then a person looks. The client is waiting on somebody else's
  /// inbox for each fix, and a third automated round is a week gone.
  screenAttempt  Int       @default(0)
  /// Three, then it stops asking the machine and asks a person.
  checkAttempt   Int       @default(0)
  /// Set when somebody sent it anyway. A gate nobody can pass gets worked
  /// around outside the product, which is worse than a gate with a log.
  overriddenById String?
  overriddenAt   DateTime?
  overrideReason String?

  /// The hop this one came from.
  ///
  /// Submitting somebody to you and you sending them onward to the client
  /// are two events days apart, and each is its own submission with its own
  /// rate and its own decision. Cloudepa → Vertex at $62 and Vertex →
  /// Terumo at $95 are two rows, one chain: the layer cake as it is.
  ///
  /// A flag could not carry the prime's rate, the prime's decision date, or
  /// the fact that a client rejected the prime's submission while the
  /// sub-vendor's still reads as live.
  parentSubmissionId String?
  parentSubmission   Submission?  @relation("forwardChain", fields: [parentSubmissionId], references: [id])
  forwardedOn        Submission[] @relation("forwardChain")

  /// When it went onward, and how. Null means it is still with whoever
  /// received it — which is the answer to the question a consultant
  /// actually asks.
  forwardedAt      DateTime?
  forwardedVia     String? // ONWARD · EMAIL
  /// Where it went when the next party is not on Etyme.
  forwardedToEmail String?
  forwardedById    String?

  /// When the buyer said yes or no. Null while they still have not.
  ///
  /// A real column rather than a proxy. How long a client takes to decide
  /// is the number a supplier cares about most — a candidate waiting on a
  /// decision is a candidate being placed somewhere else — and inferring
  /// it from a row's last write would report every decision as instant.
  decidedAt DateTime?

  @@unique([requirementId, personId]) // enforces the duplicate rule
  @@index([fromCompanyId, status])
  @@index([toCompanyId, status])
  @@index([parentSubmissionId])
  @@index([resumeId])
}

/// A consultant's CV, and specifically the copy that went out.
///
/// There was none. A submission reached a client with a name, a rate and
/// no document, which is not a submission anybody can act on — the client
/// reads the CV, not the row.
///
/// A version is never edited. Uploading again makes a new row, and a
/// submission points at the one that was actually sent, so the client's
/// copy stops changing the moment it leaves.
///
/// Bytes live in the database for now. At a few thousand CVs that is
/// unremarkable, and it keeps a deploy from waiting on a storage decision.
/// `url` is here so moving to object storage later is a write path change
/// and not a migration of the model.
model Resume {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Their own name for it: "SAP FICO 2026".
  label       String
  fileName    String
  contentType String
  sizeBytes   Int
  /// DB · URL — where the bytes actually are.
  storage     String  @default("DB")
  bytes       Bytes?
  url         String?
  /// Filled when the text can be read out, for search and for filling a
  /// profile. Null until then rather than guessed at.
  textExtract String?

  /// Who put it there, and on whose behalf. A recruiter usually holds the
  /// CV before the consultant has an account.
  uploadedById        String?
  uploadedByCompanyId String?
  uploadedByCompany   Company? @relation("resumeUploader", fields: [uploadedByCompanyId], references: [id])

  /// Set to personId while this is the current one, null otherwise. The
  /// unique index below is what stops two versions both claiming to be it.
  currentKey String?

  createdAt DateTime  @default(now())
  /// Hidden from the person's list. Never unsent: a company it was sent to
  /// can still open it, because it is in their inbox whatever we do.
  deletedAt DateTime?

  submissions Submission[]

  @@unique([personId, currentKey])
  @@index([personId, createdAt])
  @@index([uploadedByCompanyId])
}

/// The seat itself — one real job at one client, however many adverts it wears.
///
/// A sub-vendor's demand does not arrive as a requisition. It arrives as an
/// advert on Dice posted by a prime who is hiding the client so their NDA
/// holds, and the same seat is posted by three other primes the same
/// morning with the title reworded and the rate shaved.
///
/// So the client is nullable, and that is not a gap to fill in later — it
/// is the normal state, and the hiding is somebody's contract working as
/// intended. What can honestly be said instead goes in inferredClient.
model Opening {
  id        String  @id @default(cuid())
  /// The company working this seat. Openings are private: two vendors
  /// chasing the same seat each have their own row, because neither can
  /// see the other's pipeline.
  companyId String
  company   Company @relation("openingOwner", fields: [companyId], references: [id], onDelete: Cascade)

  title    String
  skills   String[]
  location String?

  /// Null while the prime is still hiding it, which is most of the time.
  clientCompanyId String?
  clientCompany   Company?  @relation("openingClient", fields: [clientCompanyId], references: [id])
  /// What can honestly be said instead: "a medical device firm, Denver".
  inferredClient  String?
  /// How the name finally arrived — at interview, on the first day, never.
  clientLearnedAt DateTime?

  headcount Int      @default(1)
  status    String   @default("LIVE") // LIVE · FILLED · COLD
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  leads           Lead[]
  suspectedBy     Lead[]           @relation("suspectedSeat")
  requirements    Requirement[]
  representations Representation[]

  @@index([companyId, status])
  @@index([clientCompanyId])
}

/// One advert, email or portal row, exactly as it arrived.
///
/// Kept whole and unedited. The fingerprint that collapses leads into a
/// seat may need rebuilding when the matching improves, and an advert
/// somebody has already normalised cannot be re-read.
model Lead {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("leadOwner", fields: [companyId], references: [id], onDelete: Cascade)

  source            String // DICE · LINKEDIN · EMAIL · DIRECT · VMS · OTHER
  /// The prime who posted it, as text. Usually a name with no company row
  /// behind it, and pretending otherwise would invent a counterparty.
  postedBy          String?
  /// Their company row, once there is one to point at.
  postedByCompanyId String?
  postedByCompany   Company? @relation("leadPoster", fields: [postedByCompanyId], references: [id])

  title     String
  skills    String[]
  location  String?
  /// Cents per hour as posted — a ceiling to bid under, not an offer.
  rateCents Int?
  contact   String?
  /// The advert, whole.
  text      String?
  seenAt    DateTime @default(now())

  /// The seat this advert is for, once somebody or something decided.
  openingId     String?
  opening       Opening? @relation(fields: [openingId], references: [id])
  /// SAME collapses on its own; LIKELY waits for a person. Nothing merges
  /// silently — the same rule CLAUDE.md sets for resolving people.
  matchStrength String?
  matchBecause  String[]

  /// The seat this might be, where the matching would not commit.
  ///
  /// Separate from openingId, which is the seat this advert actually
  /// belongs to — a LIKELY lead gets its own, because nothing merges
  /// silently. Without this the question put to a person pointed at the
  /// lead's own opening, which is to say at itself.
  likeOpeningId String?
  likeOpening   Opening?  @relation("suspectedSeat", fields: [likeOpeningId], references: [id])
  confirmedById String?
  confirmedAt   DateTime?

  @@index([companyId, seenAt])
  @@index([openingId])
  @@index([likeOpeningId])
  @@index([postedByCompanyId])
}

/// One vendor representing one person at one client.
///
/// The 2017 answer to a consultant being on several benches was to forbid
/// it: accepting one bench invitation auto-rejected every other pending one
/// (`job_invitation.rb` reject_request), so somebody belonged to whichever
/// recruiter asked first. People kept their other benches off the platform
/// instead, which left the data wrong about the one thing it needed to be
/// right about.
///
/// Benches are not exclusive here. This is, because this is where sharing
/// actually costs somebody: two vendors submitting the same person to the
/// same client in the same week gets both rejected and the consultant never
/// finds out why.
///
/// Taken automatically at submission — no form, no signature — and given
/// back the moment the vendor stops trying.
model Representation {
  id              String   @id @default(cuid())
  personId        String
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// The vendor doing the representing.
  companyId       String
  company         Company  @relation("representingVendor", fields: [companyId], references: [id], onDelete: Cascade)
  /// The client they are held at. The end client where that is known,
  /// because two primes feeding one site is the case this exists for.
  ///
  /// Nullable now: most demand is blind, and a hold that needs the client's
  /// name protects nobody on exactly the roles where it matters most.
  clientCompanyId String?
  clientCompany   Company? @relation("representedAtClient", fields: [clientCompanyId], references: [id], onDelete: Cascade)

  /// The seat, when the client has no name yet. holdKey is built from the
  /// client where it is known and from this where it is not, so a blind
  /// role is still held against everybody else.
  openingId     String?
  opening       Opening?     @relation(fields: [openingId], references: [id])
  /// The role it started with. Context for the person, not a constraint —
  /// the hold covers the client, not one requisition.
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])

  state   String   @default("HELD") // HELD · REQUESTED · RELEASED · EXPIRED · DECLINED
  takenAt DateTime @default(now())

  /// When the person themselves agreed to be put forward for this.
  ///
  /// Separate from the hold, and the difference matters. The hold is a
  /// claim against other vendors. This is the consultant saying yes.
  /// Holding somebody who never agreed is exactly the blind submission
  /// that makes consultants stop answering the phone — and when two
  /// vendors put the same person forward, the client rejects both.
  consentedAt    DateTime?
  /// SMS · EMAIL · PORTAL · VERBAL — how they said yes, for when somebody
  /// asks six months later.
  consentVia     String?
  /// When they were asked. Asked and not answered is its own state.
  consentAskedAt DateTime?
  expiresAt      DateTime
  endedAt        DateTime?
  /// Said in plain English, because the person reads this.
  endedReason    String?
  /// Who gave it back: the vendor, the person, or the system on expiry.
  endedBy        String?

  /// Set to clientCompanyId while the hold is live, null once it is not.
  ///
  /// The uniqueness below is the whole invariant, and it has to be the
  /// database's rather than the route's — a second route, an import, or a
  /// retry under load would otherwise put two vendors on the same person at
  /// the same client, which is the exact thing this prevents.
  holdKey String?

  @@unique([personId, holdKey])
  @@index([companyId, state])
  @@index([personId, state])
  @@index([clientCompanyId, state])
  @@index([requirementId])
  @@index([openingId])
}

/// A client this person will not be put in front of.
///
/// Theirs, and no vendor may see the reason. Most of them are "that is my
/// current client" and the rest are nobody's business. A vendor is told the
/// submission cannot be made and nothing else, because "they have blocked
/// you" and "they have blocked somebody" are both more than a vendor needs
/// and enough to start an argument the person should not have to have.
model DoNotSubmit {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation("doNotSubmitCompany", fields: [companyId], references: [id], onDelete: Cascade)
  /// Their own note to themselves. Never leaves their own screen.
  note      String?
  createdAt DateTime @default(now())

  @@unique([personId, companyId])
  @@index([personId])
}

// Computed from ownership, never chosen by the user. 2017 console_controller.
enum SubmissionKind {
  INTERNAL
  BENCH
  NETWORK
}

// ─────────────────────────────────────────────
// CONTRACTS  — always separate: sell separately, buy separately, link for profitability.
// A SellContract is "we sell Person X to Client Y at $N/hr".
// A BuyContract is "we pay Person X (or Vendor Z for Person X) at $M/hr".
// ContractLink joins buy↔sell within ONE company for margin/profitability tracking.
// The 2017 Assignment model combined both — causing ghost contracts, orphan cycles,
// and no way to track profitability on commission or subcontracting arrangements.
// ─────────────────────────────────────────────

// SELL CONTRACT — the vendor's record of what they bill a client for a consultant
//
// Three-party distinction (BRD Addendum C "layer cake"):
//   companyId       = the vendor selling talent (Etyme's paying customer)
//   clientCompanyId = the PAYING CUSTOMER — who the vendor invoices
//                     Could be the end client, an MSP, or a prime SI
//   endClientCompanyId = the END CLIENT — where the consultant actually works
//                     Null when paying customer IS the end client (most common case)
//   workLocationId  = specific work site at the end client
//
// Tenure (Addendum E) aggregates at the END CLIENT, not the paying customer.
// Use resolvedEndClientId() helper: endClientCompanyId ?? clientCompanyId
model SellContract {
  id                 String           @id @default(cuid())
  companyId          String // the vendor selling talent
  company            Company          @relation("sellVendor", fields: [companyId], references: [id])
  clientCompanyId    String // the paying customer — who the vendor invoices
  clientCompany      Company          @relation("sellClient", fields: [clientCompanyId], references: [id])
  endClientCompanyId String? // the end client where consultant works (null = same as clientCompanyId)
  endClientCompany   Company?         @relation("sellEndClient", fields: [endClientCompanyId], references: [id])
  personId           String
  person             Person           @relation(fields: [personId], references: [id])
  engagementId       String?
  engagement         Engagement?      @relation(fields: [engagementId], references: [id])
  msaId              String? // master agreement (denormalised from engagement for query convenience)
  msa                MasterAgreement? @relation(fields: [msaId], references: [id])
  workLocationId     String? // specific site at the end client
  workLocation       CompanyLocation? @relation(fields: [workLocationId], references: [id])

  // Addendum E — who at the END CLIENT owns this engagement.
  // A contract knows its vendor, its client, and its site, but until now not
  // which manager and which department it belongs to. Every client governance
  // capability needs that edge: the multi-manager org view, rate variance by
  // skill, approval routing, and headcount plans all aggregate on it.
  // Null on vendor-side contracts where the client has not named an owner.
  hiringManagerId String?
  hiringManager   Person?  @relation("hiringManager", fields: [hiringManagerId], references: [id])
  orgUnitId       String? // the end client's department / cost centre
  orgUnit         OrgUnit? @relation(fields: [orgUnitId], references: [id])

  /// Which account or practice inside the SELLING firm this belongs to.
  ///
  /// A contract has two org sides and they belong to different companies:
  /// whose budget pays for it at the client (orgUnitId above), and which
  /// account owns the delivery at the supplier (this). A prime running
  /// thirty client accounts needs the second to keep one account from
  /// reading another's staffing — the first is the client's own structure
  /// and says nothing about the supplier's.
  deliveryUnitId String?
  deliveryUnit   OrgUnit? @relation("deliveryUnit", fields: [deliveryUnitId], references: [id])

  // The PO this contract invoices against, on the vendor→payer leg.
  // The demand this contract satisfies. Without it a placement cannot be
  // traced back to the requisition that authorised it, seats cannot be
  // counted, and spend cannot be reconciled against the budget that was
  // approved. Null on contracts that did not come from a requisition.
  /// The order this assignment bills under. Five contractors on one
  /// project is five contracts and one order.
  salesOrderId    String?
  salesOrder      SalesOrder?              @relation(fields: [salesOrderId], references: [id])
  /// Where the cost lands in the client's books. Either a standing
  /// department or a project pot with an end date, never both.
  costCenterId    String?
  costCenter      CostCenter?              @relation(fields: [costCenterId], references: [id])
  internalOrderId String?
  internalOrder   InternalOrder?           @relation(fields: [internalOrderId], references: [id])
  requirementId   String?
  requirement     Requirement?             @relation(fields: [requirementId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id])
  // How the end client splits this cost across their budgets.
  costAllocations ContractCostAllocation[]

  billRate           Int // cents per hour
  billCurrency       String            @default("USD")
  paymentTerms       Int               @default(30) // NET days — cascades from MSA, overridable
  state              SellContractState @default(DRAFT)
  startDate          DateTime
  endDate            DateTime?
  conversionFee      Int? // contract-to-hire conversion fee (cents)
  conversionEligible DateTime? // earliest eligible date
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  buyLinks     ContractLink[] // linked buy contracts (for profitability)
  timesheets   Timesheet[]
  invoiceLines InvoiceLine[]
  sellCycles   Cycle[]        @relation("sellCycles")
  rolloff      RolloffEvent?
  docs         DocInstance[]  @relation("sellDocs")
  expenses     Expense[]
  // ── What a period is, on this contract ─────────────────────────────
  //
  // The contract says what a period is; the timesheet does not. Invoice
  // generation used to take the timesheets it was billing, find the
  // earliest, and call that the start — so four weekly sheets produced an
  // invoice for "28 July to 24 August", a period in no contract and
  // matching no purchase order window.
  //
  // Two of these are genuine business variation rather than a default
  // anybody can infer, which is why they are fields and not a rule:
  //
  //   anchor    where a month starts. The 1st, which is what an MSP or a
  //             VMS portal imposes, or the day the contract began, which
  //             is common on direct deals.
  //
  //   straddle  what happens to a week crossing a period boundary. Split
  //             it by day — exact, because hours are stored per day — or
  //             move the whole timesheet one way. Some clients will not
  //             accept a part-week line.

  /// WEEKLY · BIWEEKLY · SEMIMONTHLY · MONTHLY
  billFrequency String @default("MONTHLY")
  /// CALENDAR · CONTRACT
  billAnchor    String @default("CALENDAR")
  /// SPLIT · END · START
  billStraddle  String @default("SPLIT")

  @@index([companyId, state])
  @@index([clientCompanyId])
  @@index([endClientCompanyId])
  @@index([personId])
  @@index([endDate])
  @@index([hiringManagerId])
  @@index([orgUnitId])
  @@index([requirementId])
  @@index([engagementId])
  @@index([msaId])
  @@index([workLocationId])
  /// the three-way match reads every contract on a PO
  @@index([purchaseOrderId])
  @@index([deliveryUnitId])
  @@index([costCenterId])
  @@index([internalOrderId])
  @@index([salesOrderId])
}

enum SellContractState {
  DRAFT // terms agreed, not yet submitted for verification
  PENDING_VERIFICATION // verification checklist open — gates on I-9, insurance, etc.
  VERIFIED // all required verifications pass
  IN_PROGRESS // work started, timesheets and billing active
  PAUSED // temporarily suspended (client request, visa issue, etc.)
  ENDED // normal completion
  CANCELLED // terminated before start or during
}

// BUY CONTRACT — the company's record of what they pay for talent
// For direct employment: vendorCompanyId is null, entityId points to payroll entity.
// For subcontracting: vendorCompanyId points to the vendor supplying the talent.
// For commissions: commissionType + commissionRate define the payout; one buy contract
//   can link to many sell contracts via ContractLink (the "commission umbrella" pattern).
// The agreement a company buys talent under. One buy contract may cover
// MANY candidates — a subcontract with a vendor routinely supplies several
// people on one agreement, each at their own rate and their own dates.
// Per-candidate terms live on BuyContractCandidate.
model BuyContract {
  id              String       @id @default(cuid())
  companyId       String // the company paying
  company         Company      @relation("buyer", fields: [companyId], references: [id])
  vendorCompanyId String? // who they're buying from (null = direct employment)
  vendorCompany   Company?     @relation("buyVendor", fields: [vendorCompanyId], references: [id])
  entityId        String? // legal entity for payroll (Infosys India vs Infosys US)
  entity          LegalEntity? @relation(fields: [entityId], references: [id])

  candidates BuyContractCandidate[]

  payCurrency  String           @default("USD")
  contractType ContractType     @default(W2)
  state        BuyContractState @default(DRAFT)
  startDate    DateTime
  endDate      DateTime?

  // Commission configuration — only for commission-type buy contracts
  commissionType CommissionType? // null = not a commission arrangement
  commissionRate Int? // interpretation depends on commissionType:
  //   PER_HOUR: cents per hour worked
  //   FIXED_PER_PERIOD: cents per period
  //   ON_PLACEMENT: total cents (one-time)
  //   MARGIN_SHARE: basis points (e.g. 2500 = 25%)
  commissionCap  Int? // max total commission in cents (null = uncapped)

  // The PO this company issued to the sub-vendor supplying this person.
  //
  // Only meaningful when vendorCompanyId is set — you do not raise a PO to
  // your own W2 employee. On a subcontract the buy contract and the PO
  // describe the same commercial relationship from two angles: the buy
  // contract carries the RATE, the PO carries the CEILING it draws down.
  // Linking them stops the two records disagreeing.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellLinks ContractLink[] // linked sell contracts (for profitability)
  buyCycles Cycle[]        @relation("buyCycles")
  docs      DocInstance[]  @relation("buyDocs")
  // ── What a period is, on this contract ─────────────────────────────
  //
  // The contract says what a period is; the timesheet does not. Payroll
  // generation used to take the timesheets it was paying, find the
  // earliest, and call that the start — so four weekly sheets produced an
  // invoice for "28 July to 24 August", a period in no contract and
  // matching nothing the consultant was told.
  //
  // Two of these are genuine business variation rather than a default
  // anybody can infer, which is why they are fields and not a rule:
  //
  //   anchor    where a month starts. The 1st, which is what an MSP or a
  //             VMS portal imposes, or the day the contract began, which
  //             is common on direct deals.
  //
  //   straddle  what happens to a week crossing a period boundary. Split
  //             it by day — exact, because hours are stored per day — or
  //             move the whole timesheet one way. Some clients will not
  //             accept a part-week line.

  /// WEEKLY · BIWEEKLY · SEMIMONTHLY · MONTHLY
  payFrequency String @default("MONTHLY")
  /// CALENDAR · CONTRACT
  payAnchor    String @default("CALENDAR")
  /// SPLIT · END · START
  payStraddle  String @default("SPLIT")

  @@index([companyId, state])
  @@index([vendorCompanyId])
  @@index([endDate])
  @@index([entityId])
  @@index([purchaseOrderId])
}

// One person on a buy contract, at their own rate and dates.
//
// Rates differ per person, and someone can roll off while the agreement
// continues, so both live here rather than on the agreement. A direct
// employment contract normally has exactly one of these; a subcontract
// with a vendor often has several.
model BuyContractCandidate {
  id            String      @id @default(cuid())
  buyContractId String
  buyContract   BuyContract @relation(fields: [buyContractId], references: [id], onDelete: Cascade)
  personId      String
  person        Person      @relation(fields: [personId], references: [id])

  payRate     Int // cents per hour (or salary equivalent)
  payCurrency String    @default("USD")
  startDate   DateTime
  endDate     DateTime?
  // A person may leave while the agreement runs on for everyone else.
  state       String    @default("ACTIVE") // ACTIVE · ENDED · REPLACED
  createdAt   DateTime  @default(now())

  @@unique([buyContractId, personId])
  @@index([personId])
  @@index([buyContractId])
}

enum BuyContractState {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  IN_PROGRESS
  BENCH_PAID // consultant on bench, being paid between client assignments
  INTERNAL // company's own employee (no client assignment)
  TRAINING // in a training program
  PAUSED
  ENDED
  CANCELLED
}

enum ContractType {
  W2 // employer of record
  C2C // corp-to-corp subcontracting
  IND_1099 // independent contractor
  C2H_W2 // contract-to-hire converting to W2
  CDD // contrat à durée déterminée (fixed-term, EU/FR)
  FIXED_TERM // general fixed-term employment
}

enum CommissionType {
  PER_HOUR // fixed cents per hour worked across linked sell contracts
  FIXED_PER_PERIOD // fixed amount per pay period
  ON_PLACEMENT // one-time placement fee
  MARGIN_SHARE // percentage of margin (sell − buy across linked contracts)
}

// Links buy contracts to sell contracts within ONE company for profitability tracking.
// Example: GSA links their SellContract (to client, $150/hr) with their BuyContract
// (from primary vendor, $100/hr) → $50/hr margin visible on profitability dashboard.
// Commission umbrella: one BuyContract (commission agent) links to 10 SellContracts.
model ContractLink {
  id             String       @id @default(cuid())
  sellContractId String
  sellContract   SellContract @relation(fields: [sellContractId], references: [id])
  buyContractId  String
  buyContract    BuyContract  @relation(fields: [buyContractId], references: [id])
  effectiveFrom  DateTime // when this link is active from
  effectiveTo    DateTime? // null = open-ended
  createdAt      DateTime     @default(now())

  @@unique([sellContractId, buyContractId])
  @@index([buyContractId])
}

// ─────────────────────────────────────────────
// WORK AND MONEY
// ─────────────────────────────────────────────

model Engagement {
  id            String          @id @default(cuid())
  msaId         String
  msa           MasterAgreement @relation(fields: [msaId], references: [id])
  title         String
  rateCard      Json? // onshore / nearshore / offshore tiers
  invoiceCycle  String          @default("MONTHLY")
  sellContracts SellContract[]
  invoices      Invoice[]
  salesOrders   SalesOrder[]

  @@index([msaId])
}

// The 2017 nineteen cycle types, one table. Generated on contract start, extended on extension.
// Sell-side cycles: TIMESHEET_SUBMIT · TIMESHEET_APPROVE · INVOICE_GENERATE · INVOICE_DUE
// Buy-side cycles:  SALARY_PROCESS · SALARY_PAY · VENDOR_BILL_GENERATE · VENDOR_BILL_DUE · COMMISSION_CLEAR
model Cycle {
  id             String        @id @default(cuid())
  sellContractId String?
  sellContract   SellContract? @relation("sellCycles", fields: [sellContractId], references: [id], onDelete: Cascade)
  buyContractId  String?
  buyContract    BuyContract?  @relation("buyCycles", fields: [buyContractId], references: [id], onDelete: Cascade)
  kind           String // see comments above
  dueOn          DateTime // already shifted off weekends and holidays
  completedAt    DateTime?

  @@index([sellContractId, kind])
  @@index([buyContractId, kind])
  @@index([dueOn, completedAt])
}

model Timesheet {
  id             String       @id @default(cuid())
  sellContractId String
  sellContract   SellContract @relation(fields: [sellContractId], references: [id], onDelete: Cascade)
  personId       String
  person         Person       @relation(fields: [personId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  days           Json // { "2026-08-01": 8, ... }
  totalHours     Decimal      @db.Decimal(7, 2)
  status         String       @default("OPEN") // OPEN · SUBMITTED · APPROVED · PARTIAL · REJECTED
  anomalyScore   Int? // low score means low confidence; held, never auto rejected
  anomalyReason  String?

  // ── Two signatures, not one ────────────────────────────────────────
  //
  // The client approves a fact: this work happened, on these days, at
  // this site. The employer accepts a basis: this is what I will pay
  // for. Different assertions by different companies — and in a
  // forwarding chain almost never the same company. The end client
  // signs, the prime bills, the sub pays.
  //
  // One field for both meant a sub-vendor paying on somebody else's
  // signature, and a prime billing on one it never collected.

  /// The end client saying the work happened. Gates billing.
  /// When the contractor put it in. The approval window counts from
  /// here, so it cannot be inferred from updatedAt — anything else
  /// touching the row would restart somebody's clock.
  submittedAt DateTime?

  clientApprovedById String?
  clientApprovedAt   DateTime?
  /// True where the client's approval came from silence rather than a
  /// person. Never inferred from a null id — somebody reading this in
  /// four months needs it said, not deduced.
  autoApproved       Boolean   @default(false)

  /// The employer saying this is the basis for pay. Gates payroll.
  employerAcceptedById String?
  employerAcceptedAt   DateTime?
  /// What the employer will pay for, where it differs from what the
  /// client approved. Null means accepted as approved.
  acceptedHours        Decimal?  @db.Decimal(7, 2)
  acceptedNote         String?

  /// The single approval that predates the split. Kept so history reads,
  /// but new code should use the two above.
  approvedById String?
  approvedAt   DateTime?
  // Billing is expressed by InvoiceLine, which the database constrains to one
  // line per timesheet. The old loose invoiceId string enforced nothing.
  invoiceLine  InvoiceLine?

  /// Every company's position on these hours. Billing and pay both
  /// derive from here rather than from the columns above, which remain
  /// only so the two-party history still reads.
  assertions WorkAssertion[]

  @@unique([sellContractId, periodStart])
  @@index([status])
  /// a consultant's own timesheet list
  @@index([personId])
}

model Invoice {
  id             String                 @id @default(cuid())
  engagementId   String
  engagement     Engagement             @relation(fields: [engagementId], references: [id])
  number         String                 @unique
  periodStart    DateTime
  periodEnd      DateTime
  // Retained for invoices raised before line-level receipting; new invoices
  // write InvoiceLine rows and this stays null.
  lines          Json?
  invoiceLines   InvoiceLine[]
  matchOverrides InvoiceMatchOverride[]
  currency       String
  total          Decimal                @db.Decimal(12, 2)
  paid           Decimal                @default(0) @db.Decimal(12, 2)
  dueAt          DateTime
  status         String                 @default("ISSUED")
  submittedAt    DateTime?
  payments       Payment[]

  // AP references — what the payer's finance team needs to post and pay.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  remitToId       String?
  remitTo         RemitTo?       @relation(fields: [remitToId], references: [id])

  /// How many times this invoice has been put up for submission.
  ///
  /// The three-way match was the least accountable check in the build:
  /// it blocked payments and nothing anywhere counted whether it had ever
  /// been right, how often it needed a second go, or what it cost.
  matchAttempt Int @default(0)

  // ── Who is who on this invoice ─────────────────────────────────────
  //
  // A large client signs in one entity, is billed through a shared
  // services centre in another country, has the work done at a third
  // site, and pays from a fourth. Treating those as one party is how an
  // invoice reaches the wrong address and ages ninety days before
  // anybody notices.
  //
  // All optional. Null means the party is the client on the agreement,
  // which is the ordinary case and should not need four rows of setup.

  /// Who signed the agreement this is issued under.
  /// The order this invoice bills under, where there is one.
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])

  soldToId String?
  soldTo   Company?         @relation("invoiceSoldTo", fields: [soldToId], references: [id])
  /// Where the invoice is sent.
  billToId String?
  billTo   Company?         @relation("invoiceBillTo", fields: [billToId], references: [id])
  /// Where the work was actually done.
  shipToId String?
  shipTo   CompanyLocation? @relation("invoiceShipTo", fields: [shipToId], references: [id])
  /// Who settles it, where that is not the bill-to.
  payerId  String?
  payer    Company?         @relation("invoicePayer", fields: [payerId], references: [id])

  @@index([status, dueAt])
  @@index([purchaseOrderId])
  @@index([engagementId])
  @@index([remitToId])
  @@index([soldToId])
  @@index([billToId])
  @@index([shipToId])
  @@index([payerId])
  @@index([salesOrderId])
}

// Expenses — consolidates 2017 expense, client_expense, expense_account, contract_expense, expense_item.
// Two kinds: COMPANY (internal) and CLIENT_BILLABLE (passed to client on invoices).
// Lifecycle: DRAFT → SUBMITTED → APPROVED → INVOICED → PAID  or  → REJECTED at any point.
// BUILD.md §6.3: "Client-billable expenses appear on invoices."
model Expense {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  sellContractId String
  sellContract   SellContract @relation(fields: [sellContractId], references: [id])
  personId       String // consultant who incurred the expense
  person         Person       @relation(fields: [personId], references: [id])
  category       String // TRAVEL · EQUIPMENT · TRAINING · RELOCATION · MEALS · OTHER
  billable       Boolean      @default(true) // client-billable vs internal company expense
  description    String
  periodStart    DateTime
  periodEnd      DateTime
  items          Json // [{ description, quantity, unitPrice, expenseType }]
  total          Decimal      @db.Decimal(12, 2)
  receiptUrl     String?
  status         String       @default("DRAFT") // DRAFT · SUBMITTED · APPROVED · INVOICED · PAID · REJECTED
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  invoiceId      String? // linked when invoiced (client-billable only)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([companyId, status])
  @@index([sellContractId])
  @@index([personId])
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String?
  reference  String?
  receivedAt DateTime @default(now())

  /// every invoice screen sums its payments
  @@index([invoiceId])
}

// Owed between legal entities of the same company. Derived, never hand maintained.
// ─────────────────────────────────────────────
// FINANCE DIMENSIONS
//
// The same SellContract is two different things to two parties: a COST to
// the client whose budget it burns, and REVENUE to the vendor who earns the
// margin. So the dimensions are owned per company and never shared — the
// client's GL coding is not the vendor's business, and the vendor's COGS is
// certainly not the client's.
//
// Etyme carries the coding and exports it. The client's ERP stays the system
// of record for AP; this is not a general ledger.
// ─────────────────────────────────────────────

/// A cost object for work that spans cost centres.
///
/// Contingent labour on a project is very often booked to an internal
/// order rather than a cost centre: the project has a budget of its own,
/// runs across three departments, and closes when it is finished. A cost
/// centre is a standing department; an internal order is a temporary
/// pot with an end date.
///
/// Both exist because clients use both, and forcing a project onto a
/// cost centre is how the finance team stops trusting the numbers.
model InternalOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Must match the client's own ERP — "IO-4711".
  code        String
  name        String
  /// The department that owns the budget, where one does.
  orgUnitId   String?
  orgUnit     OrgUnit?    @relation(fields: [orgUnitId], references: [id])
  /// The cost centre it settles to when it closes, where it settles.
  settlesToId String?
  settlesTo   CostCenter? @relation(fields: [settlesToId], references: [id])

  /// What it is allowed to spend, in cents. Null = uncapped.
  budgetCents Int?
  currency    String    @default("USD")
  opensAt     DateTime?
  closesAt    DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  allocations  ContractCostAllocation[]
  requisitions Requirement[]

  sellContracts SellContract[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([orgUnitId])
  @@index([settlesToId])
}

model CostCenter {
  id        String   @id @default(cuid())
  companyId String // the company whose budget this is
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String // must match the owner's ERP — "MFG-FIN-4100"
  name      String
  glAccount String? // default expense/revenue account, e.g. "6120"
  orgUnitId String? // the department it funds, when they correspond
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  allocations    ContractCostAllocation[]
  headcountPlans HeadcountPlan[]
  requisitions   Requirement[]

  settledFrom InternalOrder[]

  sellContracts SellContract[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([orgUnitId])
}

// How one contract's cost is split across cost centres.
//
// A contractor shared between two departments is the normal case, not an
// edge case. Shares are basis points and must total exactly 10000 — see
// src/lib/cost-allocation.ts, which also does the largest-remainder split
// so allocated amounts sum back to the invoice total to the cent.
//
// Allocations belong to the contract and reference cost centres owned by
// the END CLIENT — where the person actually works. In the layer-cake case
// (vendor bills an MSP, consultant sits at the enterprise) the enterprise
// still needs to know which of its budgets the person burns, even though
// the invoice it pays comes from the MSP.
model ContractCostAllocation {
  id             String       @id @default(cuid())
  sellContractId String
  sellContract   SellContract @relation(fields: [sellContractId], references: [id], onDelete: Cascade)
  costCenterId   String
  costCenter     CostCenter   @relation(fields: [costCenterId], references: [id])
  shareBps       Int // basis points, 0–10000. All shares on a contract total 10000.
  glAccount      String? // overrides the cost centre default for this contract
  createdAt      DateTime     @default(now())

  /// Either a standing department or a project pot. Never both.
  internalOrderId String?
  internalOrder   InternalOrder? @relation(fields: [internalOrderId], references: [id])

  @@unique([sellContractId, costCenterId])
  @@index([sellContractId])
  @@index([internalOrderId])
}

// A purchase order from a payer to a vendor.
//
// Issued along ONE leg of the chain. In the layer-cake case there are two:
// the enterprise raises a PO to the MSP, and the MSP raises its own to the
// sub-vendor. A PO hung on the end client would be the wrong PO for the
// books of whoever actually pays.
//
// AP will not pay an invoice without a PO reference and remaining balance,
// which is why this is Phase 1 and not enterprise scope.
// One billable line, tied to the approved timesheet that justifies it.
//
// This is the goods receipt of contingent labour. In a purchasing system
// nobody pays an invoice for goods that were never receipted; the same rule
// has to hold for hours. A line without a timesheet is a claim nobody
// witnessed.
//
// The unique on timesheetId is the whole anti-double-billing control, and it
// lives in the database rather than in a service, because a service can be
// bypassed by the next route somebody writes. One timesheet bills once, ever.
// Voiding an invoice deletes its lines, which releases those timesheets to be
// billed again — the invoice header survives for audit.
model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  timesheetId String    @unique // one timesheet, one line, ever
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id])

  sellContractId String
  sellContract   SellContract @relation(fields: [sellContractId], references: [id])
  personId       String
  person         Person       @relation(fields: [personId], references: [id])

  // Cents throughout, matching every other rate in the schema.
  // Invoice.total remains a Decimal in whole currency; the two are reconciled
  // by the HEADER_TOTAL check rather than by assumption.
  hours       Decimal @db.Decimal(7, 2)
  rateCents   Int
  amountCents Int

  description String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@index([sellContractId])
  @@index([personId])
}

// An exception an AP clerk recorded against a failed match.
//
// Following the precedent already set by GovernanceEvaluation.overriddenBy:
// a control without an exception path is not stricter, it is bypassed, and
// the invoices get paid outside the system where the ledger cannot see them.
//
// Which codes may be waived is decided in code (OVERRIDABLE in
// src/lib/three-way-match.ts), not here — a row asserting a waiver on a
// duplicate payment is simply not honoured.
model InvoiceMatchOverride {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  code   String // the MatchCode being waived
  reason String // required, and shown wherever the invoice is
  byId   String
  by     Person @relation(fields: [byId], references: [id])

  // What the invoice was worth when the exception was granted, so a later
  // reader can tell whether the waiver still describes the same invoice.
  invoiceTotalCentsAtOverride Int
  createdAt                   DateTime @default(now())

  @@unique([invoiceId, code]) // one live exception per check
  @@index([byId])
}

model PurchaseOrder {
  id         String    @id @default(cuid())
  number     String // the payer's PO number
  issuedById String // payer — raises the PO
  issuedBy   Company   @relation("poIssuer", fields: [issuedById], references: [id])
  issuedToId String // vendor — invoices against it
  issuedTo   Company   @relation("poRecipient", fields: [issuedToId], references: [id])
  amount     Decimal   @db.Decimal(12, 2) // authorised ceiling
  currency   String    @default("USD")
  startDate  DateTime
  endDate    DateTime?
  status     String    @default("OPEN") // OPEN · CLOSED · CANCELLED
  createdAt  DateTime  @default(now())

  sellContracts SellContract[]
  buyContracts  BuyContract[] // the issuer's own subcontracts drawing on it
  invoices      Invoice[]

  @@unique([issuedById, number])
  @@index([issuedToId, status])
}

// Where a vendor is paid. Referenced on invoices so AP can remit.
//
// SECURITY: full bank account and routing numbers must NEVER be stored here.
// Only the last four digits, for human confirmation on a remittance advice.
// Full credentials belong in a payment provider's vault.
model RemitTo {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  legalName     String // the entity on the invoice, may differ from trading name
  addressLines  String[]
  country       String
  taxId         String? // EIN / VAT / GST registration
  paymentMethod String   @default("ACH") // ACH · WIRE · CHECK
  bankName      String?
  accountLast4  String? // display only — never the full number
  routingLast4  String? // display only — never the full number
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  invoices Invoice[]

  @@index([companyId, isDefault])
}

model IntercompanyPosition {
  id           String    @id @default(cuid())
  fromEntityId String
  toEntityId   String
  period       String // 2026-08
  amount       Decimal   @db.Decimal(12, 2)
  currency     String
  settledAt    DateTime?

  @@unique([fromEntityId, toEntityId, period])
}

// ─────────────────────────────────────────────
// RATE HISTORY — versioned rate changes for buy and sell contracts.
// BUILD.md §6.9: "Rate changes must be versioned or the timesheet valuation is unreliable."
// LEGACY_RULES.md §2.4: ChangeRate — polymorphic, date-ranged rate versioning
//   with overlap validation. No two rate periods for the same contract may overlap.
// ─────────────────────────────────────────────

model RateHistory {
  id           String    @id @default(cuid())
  contractType String // SELL | BUY
  contractId   String // sellContractId or buyContractId
  rate         Int // cents per hour (or per period depending on rateType)
  rateType     String    @default("HOURLY") // HOURLY · DAILY · WEEKLY · MONTHLY
  overtimeRate Int? // cents per hour for overtime
  fromDate     DateTime
  toDate       DateTime? // null = current/open-ended
  reason       String? // why the rate changed
  changedById  String // personId of who made the change
  previousRate Int? // the rate before this change (for audit trail)

  // A rate change is an amendment to the agreement, so it is approved
  // rather than simply written. This is what makes the invoice PRICE check
  // enforceable: the contract is the authority on price, and an invoice
  // that disagrees with it is wrong rather than merely unusual.
  //
  // Until a change is approved it does not exist for billing purposes — the
  // rate in force on a given day is resolved from APPROVED rows only
  // (src/lib/contract-rate.ts).
  approvalState String    @default("PROPOSED") // PROPOSED · APPROVED · REJECTED
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([contractType, contractId])
  @@index([contractId, fromDate])
}

// ─────────────────────────────────────────────
// BLACKLIST — filters candidates and companies out of search, feeds and contracts.
// BUILD.md §6.10: "black_lister — filters candidates and companies out of search,
// feeds and contracts."
// ─────────────────────────────────────────────

model Blacklist {
  id          String    @id @default(cuid())
  companyId   String // the company that blacklisted
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetType  String // PERSON | COMPANY
  targetId    String // personId or companyId
  reason      String
  blockedById String // personId who added the block
  blockedAt   DateTime  @default(now())
  expiresAt   DateTime? // null = permanent
  liftedAt    DateTime? // set when manually lifted
  liftedById  String?
  liftReason  String?

  @@unique([companyId, targetType, targetId])
  @@index([companyId])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────
// CONVERSATIONS — consolidates 2017 chat, chat_user, conversation,
// conversation_message, group, message into three models.
// BUILD.md §6.1: "The connective tissue. Its absence will be felt immediately."
// Auto-created threads per requirement, per contract, per document request.
// ─────────────────────────────────────────────

model Conversation {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  topic        String    @default("GENERAL") // GENERAL · REQUIREMENT · CONTRACT · SUBMISSION · DOCUMENT · INVOICE · EXPENSE · DIRECT
  topicId      String? // links to the entity (requirementId, sellContractId, etc.)
  title        String? // null for direct messages; auto-generated for topic threads
  participants Json // [{ personId, name, joinedAt }]
  parentId     String? // branch conversations (sub-chats)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages Message[]

  @@unique([companyId, topic, topicId]) // one thread per entity
  @@index([companyId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  body           String
  type           String       @default("TEXT") // TEXT · SYSTEM · RATE_CONFIRMATION · INTERVIEW · DOCUMENT_REQUEST
  metadata       Json? // type-specific payload (rate amount, interview date, doc template)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([authorId])
}

// BUILD.md §6.2: "Needs type × channel routing including Teams and email digests."
// Status: UNREAD → READ. Channel: IN_APP · EMAIL · TEAMS.
model Notification {
  id        String  @id @default(cuid())
  personId  String
  companyId String?
  type      String // SUBMISSION · TIMESHEET · INVOICE · EXPENSE · CONTRACT · ROLLOFF · CONVERSATION · SYSTEM
  title     String
  body      String
  entityId  String? // the thing this is about
  data      Json? // structured metadata (petitionId, cycleId, etc.)
  channel   String  @default("IN_APP") // IN_APP · EMAIL · TEAMS

  // Whether it LEFT, which is a different question from whether it was
  // read. A notification marked EMAIL that nothing ever sent used to sit
  // here as UNREAD — indistinguishable from one delivered and ignored, so
  // the system appeared to have told somebody when it had not.
  //
  //   PENDING         queued, not yet attempted
  //   SENT            actually left the building
  //   FAILED          attempted and did not
  //   NOT_CONFIGURED  this channel has nowhere to send to
  //
  // NOT_CONFIGURED is the important one: it makes an absent integration
  // visible instead of silent.
  deliveryState String    @default("PENDING")
  deliveryNote  String?
  deliveredAt   DateTime?

  status    String    @default("UNREAD") // UNREAD · READ
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([personId, status])
  @@index([companyId, createdAt])
  @@index([deliveryState, createdAt])
}

// ─────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────

model RolloffEvent {
  id             String       @id @default(cuid())
  sellContractId String       @unique
  sellContract   SellContract @relation(fields: [sellContractId], references: [id], onDelete: Cascade)
  triggeredAt    DateTime     @default(now())
  endDate        DateTime
  notified       Json // who was told, when, with what
  checklist      Json // knowledge transfer · final timesheet · access revocation · assets
  claimedById    String?
  outcome        String? // REDEPLOYED · BENCH · LOST

  @@index([endDate])
}

// Everything the system did on a company's behalf. Inspectable, mostly reversible.
model AutomationLog {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action     String
  summary    String
  reason     String // the rule it followed, in words
  payload    Json
  reversible Boolean   @default(false)
  reversedAt DateTime?
  at         DateTime  @default(now())

  @@index([companyId, at])
}

// ─────────────────────────────────────────────
// VERIFICATION  — person-level (I-9, background, education, drug screen)
// and company-level (insurance COI, business partner verification).
// Lives on Person or Company, NOT on contracts. Uploaded once by whoever
// is closest to the subject, checked across all tiers of the supply chain.
// See etyme-verification-chain artifact for the full design.
// ─────────────────────────────────────────────

model Verification {
  id        String   @id @default(cuid())
  personId  String? // for person-level checks (I-9, background, education, drug)
  person    Person?  @relation(fields: [personId], references: [id])
  companyId String? // for company-level checks (insurance, partner verification)
  company   Company? @relation(fields: [companyId], references: [id])

  type        VerificationType
  status      VerificationStatus @default(PENDING)
  provider    String? // "HireRight" · "Sterling" · "WES" · "ECE" · "E-Verify" · "Quest"
  referenceId String? // external provider reference number
  issuedAt    DateTime?
  expiresAt   DateTime? // null = permanent (e.g. education evaluation)
  result      Json? // { outcome: "CLEAR", notes: "...", details: {...} }

  uploadedById String // personId of whoever uploaded this
  verifiedById String? // personId of whoever verified/approved it
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  documents VerificationDoc[]

  @@index([personId, type, status])
  @@index([companyId, type, status])
  @@index([expiresAt]) // for expiry alert jobs
}

model VerificationDoc {
  id             String       @id @default(cuid())
  verificationId String
  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  fileHash       String? // SHA-256 for dedup — same file uploaded twice is stored once
  uploadedAt     DateTime     @default(now())

  @@index([verificationId])
}

enum VerificationType {
  I9_EVERIFY // federal work authorization (BLOCK gate)
  BACKGROUND_CHECK // criminal, credit, employment history (WARN gate)
  EDUCATION_EVALUATION // WES, ECE credential evaluation (WARN gate)
  DRUG_SCREENING // pre-assignment or periodic (WARN gate)
  INSURANCE_GL // general liability (BLOCK gate)
  INSURANCE_WC // workers' compensation (BLOCK gate)
  INSURANCE_EO // errors & omissions (BLOCK gate)
  INSURANCE_CYBER // cyber liability (BLOCK gate)
  BUSINESS_PARTNER // DUNS, SAM.gov, references (BLOCK for new vendors)
  REFERENCE_CHECK // professional references (informational)
}

enum VerificationStatus {
  PENDING // requested, not yet started
  IN_PROGRESS // underway (background check processing, provider working)
  CLEAR // passed — no issues found
  CONDITIONAL // passed with conditions (e.g. misdemeanor disclosed, client decides)
  FLAGGED // requires human review
  FAILED // did not pass
  EXPIRED // was valid, now past expiresAt
}

// ─────────────────────────────────────────────
// GOVERNANCE  — client-configurable rules evaluated at submission,
// assignment, extension, and alumni re-engagement.
// Addendum E: BLOCK where legally grounded, WARN everywhere else.
// Never silently permit. See etyme-governance-rules artifact.
// ─────────────────────────────────────────────

model GovernancePolicy {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String // "Standard Contingent Workforce Policy"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules GovernanceRule[]

  @@index([companyId, isActive])
}

model GovernanceRule {
  id              String             @id @default(cuid())
  policyId        String
  policy          GovernancePolicy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType        GovernanceRuleType
  enforcementMode EnforcementMode
  parameters      Json // type-specific: { maxMonths: 18, exemptCompanyKinds: ["MSP"] }
  description     String // plain English: "No direct vendor hire beyond 18 months"
  // Whose decision a breach is. Defaults per rule type in
  // src/lib/governance-teams.ts; set here when a client differs.
  ownerTeam       ClientTeam?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())

  evaluations GovernanceEvaluation[]

  @@index([policyId, isActive])
}

enum GovernanceRuleType {
  TENURE_CAP // max months at client across all vendors (Addendum E)
  BREAK_IN_SERVICE // required gap between engagements (co-employment)
  RATE_BAND // rate must fall within approved range
  HEADCOUNT_PLAN // position count vs approved headcount
  VENDOR_TIER // vendor must be approved/preferred tier
  WORK_AUTHORIZATION // valid work auth required before start
  INSURANCE_REQUIRED // vendor must have current insurance
  SEGREGATION_OF_DUTIES // same person cannot hold conflicting roles
  WORKER_CLASSIFICATION // which ways of engaging somebody this client accepts
}

// Which team at the client adjudicates a breach of a rule.
//
// A client is not one person. A tenure cap breach is HR's to decide — it is
// co-employment exposure. A lapsed supplier insurance certificate is
// procurement's. A rate above band is procurement's. Going over the
// headcount plan belongs to whoever owns the budget. Routing all of them to
// one "approver" is the thing that makes governance feel like a queue
// rather than somebody's job.
enum ClientTeam {
  HIRING_MANAGER // needs the person; owns the plan and the budget line
  PROCUREMENT // owns vendors, rates, contracts, spend
  HR // owns co-employment, tenure, classification, work authorisation
  LEGAL // owns anything that ends up in front of a regulator
}

enum EnforcementMode {
  BLOCK // legally grounded — cannot proceed (tenure, break-in-service, work auth, insurance)
  WARN // capture a reason, proceed (rate band, headcount, vendor tier)
}

// Every governance evaluation, pass or fail, is recorded. Auditable trail.
model GovernanceEvaluation {
  id           String         @id @default(cuid())
  ruleId       String
  rule         GovernanceRule @relation(fields: [ruleId], references: [id])
  triggerPoint String // SUBMISSION · CONTRACT_START · EXTENSION · ALUMNI_REENGAGEMENT
  subjectType  String // PERSON · SELL_CONTRACT · BUY_CONTRACT
  subjectId    String
  outcome      String // PASS · WARN · BLOCK
  reason       String // plain English: "Ravi Patel has 19 months at AMAT (cap: 18)"
  overriddenBy String? // personId of who overrode a WARN
  overrideNote String? // why the override was justified
  evaluatedAt  DateTime       @default(now())

  @@index([ruleId, evaluatedAt])
  @@index([subjectType, subjectId])
}

// ─────────────────────────────────────────────
// TRAINING  — courses offered by companies (free or paid),
// enrolled by consultants. Part of the bench vendor value prop
// (free website + free/paid training). See etyme-value-architecture artifact.
// ─────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String? // TECH · COMPLIANCE · SOFT_SKILLS · CERTIFICATION · AI_UPSKILLING
  duration    Int? // estimated hours
  price       Int? // cents — null = free
  currency    String   @default("USD")
  isPublic    Boolean  @default(false) // visible to candidates outside the company
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]

  @@index([companyId, isPublic])
}

model Enrollment {
  id             String    @id @default(cuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id])
  personId       String
  person         Person    @relation(fields: [personId], references: [id])
  status         String    @default("ENROLLED") // ENROLLED · IN_PROGRESS · COMPLETED · DROPPED
  enrolledAt     DateTime  @default(now())
  completedAt    DateTime?
  score          Int?
  certificateUrl String?

  @@unique([courseId, personId])
  @@index([personId, status])
}

// ─────────────────────────────────────────────
// DOCUMENTS  — five 2017 library models and six doc set models, collapsed
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// SHARING DOCUMENTS OUTSIDE THE COMPANY
//
// An immigration lawyer preparing an H1B petition, an accountant filing a
// franchise registration, an auditor sampling contracts. They need a
// specific set of documents, once, and they must not need an account here
// to read them — a lawyer asked to create a login will ask you to email the
// files instead, and then the files are in an inbox forever.
//
// So a share is a package with a link, and three properties that make it
// safe to send: it expires, it can be killed, and every time somebody opens
// it that is recorded.
// ─────────────────────────────────────────────

model DocumentShare {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Who it is for. An email address rather than a user, deliberately.
  recipientEmail String
  recipientName  String?
  recipientRole  String? // "Immigration attorney" · "CPA" · "Auditor"

  // What it is for, in words the subject would recognise if they asked why
  // their passport was sent to a stranger.
  purpose String

  // The person these documents are about, when they are about somebody.
  // Present so the subject can see who has been reading their file — the
  // AccessLog invariant applies to outsiders too.
  subjectPersonId String?
  subjectPerson   Person? @relation("shareSubject", fields: [subjectPersonId], references: [id])

  // The link. Long and random; the only credential.
  token String @unique

  // Always set. A share with no end date is a leak with a delay on it.
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedById String?

  createdById String
  createdBy   Person   @relation("shareCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  items    DocumentShareItem[]
  accesses DocumentShareAccess[]

  @@index([companyId, expiresAt])
  @@index([subjectPersonId])
  @@index([createdById])
}

// One document in the package. Documents live in three different models in
// this schema, so the reference is by kind and id rather than a foreign key.
model DocumentShareItem {
  id      String        @id @default(cuid())
  shareId String
  share   DocumentShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  kind  String // VERIFICATION_DOC · VISA_DOCUMENT · DOC_INSTANCE
  refId String
  // What the recipient sees. A lawyer should not have to open six files to
  // find the I-797.
  label String

  @@index([shareId])
}

// Every open, recorded. Not for the company's comfort — so the person whose
// documents these are can see who read them and when.
model DocumentShareAccess {
  id      String        @id @default(cuid())
  shareId String
  share   DocumentShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  at        DateTime @default(now())
  ipAddress String?
  userAgent String?
  // Which document was opened, when they opened one rather than the index.
  itemId    String?

  @@index([shareId, at])
}

model DocTemplate {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  audience       String // CANDIDATE · VENDOR · CLIENT · EMPLOYEE · GENERAL
  needsSignature Boolean       @default(false)
  fileUrl        String?
  instances      DocInstance[]

  @@index([companyId, audience])
}

model DocInstance {
  id             String        @id @default(cuid())
  templateId     String
  template       DocTemplate   @relation(fields: [templateId], references: [id])
  sellContractId String?
  sellContract   SellContract? @relation("sellDocs", fields: [sellContractId], references: [id])
  buyContractId  String?
  buyContract    BuyContract?  @relation("buyDocs", fields: [buyContractId], references: [id])
  subjectType    String // SELL_CONTRACT · BUY_CONTRACT · PERSON · COMPANY
  subjectId      String
  status         String        @default("PENDING") // PENDING · SENT · SIGNED · UPLOADED
  envelopeId     String? // DocuSign
  signedFileUrl  String?
  signedAt       DateTime?

  @@index([subjectType, subjectId, status])
  @@index([templateId])
  @@index([sellContractId])
  @@index([buyContractId])
}

// ─────────────────────────────────────────────
// IMPORT  — the onboarding path. Rows land even when incomplete.
// ─────────────────────────────────────────────

model Import {
  id          String      @id @default(cuid())
  companyId   String
  kind        String // PEOPLE · CONTRACTS · CONTACTS
  fileName    String?
  mapping     Json // AI proposed, human corrected
  rowCount    Int
  issueCount  Int
  committedAt DateTime?
  rows        ImportRow[]
  createdAt   DateTime    @default(now())
}

model ImportRow {
  id        String   @id @default(cuid())
  importId  String
  import    Import   @relation(fields: [importId], references: [id], onDelete: Cascade)
  raw       Json
  parsed    Json
  issues    String[] // "no rate in the file" — never blocking
  createdId String? // what it became once committed

  @@index([importId])
}

// Per-company holiday calendar — CLAUDE.md: "Load-bearing for cycle generation."
// The cycle generator shifts due dates off weekends AND these holidays.
// Each company defines its own set. A US vendor might have 10 federal holidays;
// a Japanese client might have different ones. Both sets apply to a cross-border contract.
model Holiday {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  name        String // "Independence Day", "Christmas", "Golden Week"
  isRecurring Boolean  @default(false) // repeats annually (month+day)
  country     String? // ISO 3166 alpha-2 if region-specific
  createdAt   DateTime @default(now())

  @@unique([companyId, date])
  @@index([companyId])
  @@index([date])
}

/// ─────────────────────────────────────────────────────────────────────
/// The event log.
///
/// Append-only. Nothing updates a row here and nothing deletes one; the
/// only operation is insert. That is what makes it worth anything — an
/// audit trail somebody can edit is a story, not a record.
///
/// Three jobs, which is why it earns its place before any integration:
///
///   1. Audit. What happened, in order, with who did it. The automation
///      log says what the system did unprompted; this says what happened
///      at all.
///   2. Replay. Rebuilding a view, or answering "what did the approval
///      chain look like in March", needs the sequence, not the current
///      state.
///   3. Integration. Every outbound webhook and every ERP file is a
///      reader of this stream. Without it each connector has to poll
///      tables and guess what changed.
///
/// `seq` is a database-assigned running number, so consumers can say
/// "everything after 40213" and get an answer that does not depend on
/// clocks agreeing.
model Event {
  id  String @id @default(cuid())
  seq BigInt @default(autoincrement())

  /// The tenant. Null only for platform-level events that belong to
  /// nobody — a company being created is the main one.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  /// Dotted and past tense: "requisition.approved", "invoice.paid".
  /// Past tense because an event is something that already happened;
  /// naming one "invoice.pay" invites somebody to treat it as a command.
  type String

  /// What it happened to, so a subject's whole history is one query.
  subjectType String
  subjectId   String

  /// Who did it. Null when nobody did — a cycle falling due has no actor.
  actorPersonId String?
  actorPerson   Person? @relation("eventActor", fields: [actorPersonId], references: [id])
  /// PERSON · AUTOMATION · SERVICE — a service account is not a person
  /// and an auditor needs to see which one moved the money.
  actorKind     String  @default("PERSON")

  /// The facts of the event, enough to act on without reading the row it
  /// came from. Deliberately a blob: this is a log, and the shape of an
  /// event from 2026 must stay readable in 2030 without a migration.
  payload Json

  occurredAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([companyId, seq])
  @@index([type, occurredAt])
  @@index([subjectType, subjectId])
  /// "what did this person do" is the question an auditor opens with
  @@index([actorPersonId])
}

/// A request for documents, or an offer of them.
///
/// The same object in both directions. Collecting and sending are one
/// thing seen from two ends — whether you are asking or answering is a
/// property of this row, not of the list it was built from.
///
/// The counterparty needs no account. Delivery reuses the expiring-link
/// mechanism already built for sharing files with a lawyer, because a
/// supplier's office manager will not create a login to upload a W-9, and
/// a system that requires one simply does not get the W-9.
model DocumentPacket {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Which list this was built from (src/lib/packets.ts).
  packetKey String
  label     String
  purpose   String

  /// COLLECT — we are asking them. SEND — we are giving them ours.
  direction String @default("COLLECT")

  /// Who it is about. A company for supplier onboarding, a person for a
  /// submission or an immigration filing.
  subjectCompanyId String?
  subjectCompany   Company? @relation("packetSubjectCompany", fields: [subjectCompanyId], references: [id])
  subjectPersonId  String?
  subjectPerson    Person?  @relation("packetSubjectPerson", fields: [subjectPersonId], references: [id])

  /// Where it is going. An address rather than a user, deliberately.
  recipientEmail String
  recipientName  String?

  /// The link. Long and random; the only credential.
  token String @unique

  /// Always set. A request with no end is a link that outlives the reason
  /// it was sent.
  expiresAt   DateTime
  completedAt DateTime?
  cancelledAt DateTime?

  /// Why this was reopened, when it was. Insurance lapsing reopens a
  /// packet automatically, and the recipient deserves to know why they
  /// are being asked again.
  reopenedReason String?

  createdById String
  createdBy   Person   @relation("packetCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  items PacketItem[]

  @@index([companyId, completedAt])
  @@index([subjectCompanyId])
  @@index([subjectPersonId])
  @@index([createdById])
}

/// One thing being asked for, and whether it arrived.
model PacketItem {
  id       String         @id @default(cuid())
  packetId String
  packet   DocumentPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)

  /// Matches ItemSpec.key in src/lib/packets.ts.
  key      String
  label    String
  hint     String
  required Boolean @default(true)

  /// Where it sits in the list. Without this the order comes back from
  /// the database however it likes, so a recipient's checklist rearranges
  /// itself every time they upload something — which reads as the page
  /// losing their work.
  position Int @default(0)

  /// PENDING · RECEIVED · ACCEPTED · REJECTED
  ///
  /// Received and accepted are different: a file arriving is not the same
  /// as somebody having looked at it, and treating them as one is how an
  /// expired certificate passes for a current one.
  state String @default("PENDING")

  fileUrl    String?
  fileName   String?
  receivedAt DateTime?
  /// When the document itself stops counting, not when the request does.
  validUntil DateTime?

  reviewedById String?
  reviewedBy   Person?   @relation("packetItemReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  /// The verification row this became, where it maps onto one. Keeps the
  /// compliance checks reading from one place rather than two.
  verificationId String?

  @@index([packetId, position])
  @@index([reviewedById])
}

/// A machine that calls the API.
///
/// Integrations need an identity, and giving one a person's account is how
/// a leaver's departure breaks the nightly ERP feed — or worse, does not,
/// and their access outlives them.
///
/// Same posture as a person's access: scoped, expiring by default, and its
/// last use recorded, because a key nobody has used in three months is
/// exposure rather than integration.
model ServiceAccount {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String // "SAP AP feed", "Workday joiner sync"
  description String?

  /// Only the hash is stored. The key itself is shown once, at creation,
  /// and cannot be recovered — a system that can show you a key again is
  /// one that can be made to show it to somebody else.
  keyHash   String @unique
  /// The first characters, so somebody can tell two keys apart in a list
  /// without either being usable.
  keyPrefix String

  /// What it may do. The same permission strings a role uses, so there is
  /// one vocabulary rather than two.
  permissions String[]

  /// Access ends by default. Null is permitted for read-only and argued
  /// for otherwise.
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  revokedById String?

  createdById String
  createdBy   Person   @relation("serviceAccountCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  webhooks WebhookSubscription[]

  @@index([companyId, revokedAt])
  @@index([keyPrefix])
  @@index([createdById])
}

/// Somewhere to send events as they happen.
///
/// The alternative is every integration polling tables and guessing what
/// changed, which is what the event log exists to end.
model WebhookSubscription {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Which service account owns it, so revoking the account stops the
  /// deliveries too rather than leaving a mouth still talking.
  serviceAccountId String?
  serviceAccount   ServiceAccount? @relation(fields: [serviceAccountId], references: [id])

  name String
  url  String

  /// Event names from EVENT_TYPES. Empty means everything, which is
  /// allowed but rarely what somebody means.
  eventTypes String[]

  /// Payloads are signed with this so the receiver can tell our delivery
  /// from anybody else's POST. Never returned after creation.
  signingSecret String

  isActive Boolean @default(true)

  /// Where this subscriber has got to. A delivery that fails is retried
  /// from here rather than lost.
  lastDeliveredSeq BigInt @default(0)

  /// Switched off automatically after repeated failure, with the reason
  /// kept — a webhook silently dropping events is the failure mode that
  /// costs the most trust.
  disabledAt     DateTime?
  disabledReason String?

  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([companyId, isActive])
  @@index([serviceAccountId])
}

/// One attempt to deliver one event.
///
/// Kept per attempt rather than per event, because "it was sent" and "it
/// was sent on the fourth try after two timeouts" are different facts and
/// only the second explains a support conversation.
model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// PENDING · SENT · FAILED · ABANDONED
  state         String    @default("PENDING")
  attempt       Int       @default(1)
  statusCode    Int?
  /// What went wrong, in words rather than a stack trace.
  note          String?
  /// When to try again. Null once it succeeded or was given up on.
  nextAttemptAt DateTime?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  /// One delivery per event per subscription. Without this, a crash
  /// between queueing deliveries and advancing the cursor sends the same
  /// event twice — and skipDuplicates on the insert would be decoration.
  @@unique([subscriptionId, eventId])
  @@index([subscriptionId, state])
  @@index([state, nextAttemptAt])
}

/// An address a company used to have.
///
/// When a company changes its Etyme address the old one is kept and
/// redirects, rather than being released. Every link anybody saved — an
/// invitation email, a document request sent to a supplier's office
/// manager, an invoice footer — keeps working, and that is the whole
/// reason changing an address is safe to offer at all.
///
/// A released name is never handed to another company. A subdomain that
/// used to be one firm's address, given to somebody else, means old links
/// land on a stranger's data.
/// A domain a company has claimed.
///
/// Not its identity. `Company.domain` used to be a single unique string
/// and the company *was* that domain, which is a common pattern and wrong
/// in ways that only appear once real companies arrive: a conglomerate
/// holds dozens, subsidiaries share a family and are deliberately separate
/// tenants, a merger needs two tenants to become one, and a rebrand should
/// not cost a company its identity.
///
/// Exact domains, never reduced. `us.infosys.com` is its own claim — if
/// Infosys wants it under the same tenant they add it, and if they do not
/// it stays separate. The company decides, not DNS.
model CompanyDomain {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Exactly as claimed. Unique across the platform, because two companies
  /// admitting people through the same domain is a tenancy leak.
  domain String @unique

  /// Unverified until proved. A claim can admit people to a tenant, so it
  /// is never taken on somebody's word — except where an identity provider
  /// already asserted it, which is proof enough.
  verifiedAt  DateTime?
  /// OAUTH_TENANT · DNS_TXT · MANUAL — how it was proved, because "who
  /// vouched for this" is the question an audit asks.
  verifiedVia String?
  /// The record we asked for, when it needs one.
  proofToken  String?

  /// What happens when somebody signs in on it.
  ///   AUTO     they are in
  ///   REQUEST  they get a seat, somebody is asked — the default
  ///   NONE     claimed so nobody else takes it; admits nobody
  ///
  /// REQUEST rather than AUTO by default, because letting strangers in is
  /// a decision somebody should make rather than inherit.
  joinPolicy String @default("REQUEST")

  /// The one shown as the company's own address.
  isPrimary Boolean @default(false)

  addedById String?
  createdAt DateTime @default(now())

  @@index([companyId, verifiedAt])
}

model SubdomainAlias {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The old address, still resolving.
  subdomain String @unique

  /// Why it stopped being the main one, for whoever asks in two years.
  reason       String?
  releasedAt   DateTime @default(now())
  releasedById String?

  @@index([companyId])
}

/// A domain the company owns, pointed at us.
///
/// Unverified until a DNS record only its owner could publish is visible,
/// and it serves nothing until then — anybody can type google.com into a
/// form.
model CustomDomain {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  domain String @unique

  /// PENDING · VERIFIED · FAILED — where proving ownership has got to.
  state String @default("PENDING")

  /// Per company and per domain, so a record copied from another
  /// company's screen proves nothing here.
  verificationToken String

  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  /// What the last check actually saw, so "it is not working" has an
  /// answer rather than a shrug.
  lastCheckNote String?

  /// Only one domain serves the company at a time. The others stay
  /// verified and redirect, the same way old subdomains do.
  isPrimary Boolean @default(false)

  addedById String
  addedBy   Person   @relation("customDomainAdder", fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId, state])
  @@index([addedById])
}

// ─────────────────────────────────────────────
// THE LEDGER  — what every agent did, and what it cost
// ─────────────────────────────────────────────

/// One attempt by one agent on one record.
///
/// This is not logging. Without it you cannot answer the three questions
/// that decide whether any of the model work is worth doing: what does one
/// submission cost, is that falling, and which agent is the expensive one.
///
/// The build had AutomationLog, which records what happened in plain
/// English and is good for a person reading back. It has no cost, no
/// attempt count, no model name and no duration, so it cannot answer any
/// of the three.
///
/// A row is written for rule-only work as well, with no model and no cost.
/// That absence is the point: roughly half the work in this product is
/// arithmetic and date comparison, and a ledger that only records the
/// expensive half makes the cheap half invisible.
model AgentRun {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Dotted, so it groups: "match.score", "submission.check", "cv.evidence".
  agent String

  /// What it ran on. REQUIREMENT · SUBMISSION · CONSULTANT · OPENING
  recordType String
  recordId   String

  /// 1 for the first try. A loop that fixes and re-checks writes 2, then 3.
  /// Attempts are how you find the agent that never gets it right first time.
  attempt Int @default(1)

  /// PASS · FAIL · ERROR
  ///   PASS  it did the job
  ///   FAIL  it did the job and the answer was no — a check that says no is
  ///         working, not broken
  ///   ERROR the call itself failed
  verdict    String
  failReason String?

  /// Null when no model was called.
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?

  /// Millionths of a dollar. Integer, like every other money column here.
  /// One scoring call lands around 40,000; a rule check is 0.
  costMicros Int?

  ms Int

  /// How many the rules considered, and how many reached the model.
  ///
  /// The gap between these two is the margin. Scoring everybody instead of
  /// the handful worth scoring is the difference between a business at 94%
  /// and one at 70%, and the only way to know which you are running is to
  /// write both numbers down every time.
  consideredCount Int?
  scoredCount     Int?

  at DateTime @default(now())

  checks Check[]

  @@index([companyId, at])
  @@index([recordType, recordId])
  @@index([companyId, agent, at])
}

/// One check on one thing, and who did the checking.
///
/// Kept separate from AgentRun because the identity of the checker is the
/// whole point. A rule is free and right every time. A model is neither. A
/// person is the only thing that can tell you the model has quietly
/// started being wrong.
///
/// An agent grading its own homework reports 96% accuracy while customers
/// stop calling, and by the time anybody notices the ledger has been lying
/// for months. So: machine checks and human checks are different rows,
/// counted separately, and the agreement between them is a number on a
/// screen.
model Check {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The run this check belongs to, where a machine did it. Null for a
  /// human review drawn as a sample afterwards.
  runId String?
  run   AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  recordType String
  recordId   String

  /// RULE · MODEL · HUMAN
  checker String

  /// What was checked: RATE_IN_RANGE · DOCS_PRESENT · SKILLS_EVIDENCED ·
  /// AVAILABLE_IN_WINDOW · WORK_AUTH · SCORE_HONEST
  code String

  /// PASS · FAIL
  verdict String

  /// Why, in words somebody can act on. A failed check that does not say
  /// what to fix sends people back to email.
  reason String

  /// What it read to decide — the quoted line from the CV, the two dates
  /// it compared. A claim with no evidence cannot be reviewed, only
  /// believed.
  evidence String?

  /// Set on a human review of a machine check.
  checkedById   String?
  /// Whether the person agreed with the machine. Null until reviewed.
  agreed        Boolean?
  /// Why they disagreed. This is the only thing that improves the agent.
  disagreedNote String?

  at DateTime @default(now())

  @@index([companyId, at])
  @@index([recordType, recordId])
  @@index([companyId, checker, agreed])
  @@index([runId])
}

/// One text message, out or in.
///
/// Its own model rather than a Notification, because the inbound half is
/// the entire point. A notification is something we told somebody; this is
/// a conversation, and the reply is what keeps the bench honest.
///
/// Every outbound message goes out in the vendor's name, never ours. A
/// consultant on two benches never learns that from us, and we never
/// contact anybody about a role belonging to a different vendor. The
/// moment a vendor suspects disintermediation, benches stop being
/// uploaded, and with no benches there is nothing to score.
model TextMessage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// FRESHNESS · CONSENT · OUTCOME · PLACED · LINK
  kind      String
  /// OUT · IN
  direction String
  body      String
  /// The number, for an outbound one.
  to        String?

  /// PENDING · SENT · FAILED · NOT_CONFIGURED
  ///
  /// NOT_CONFIGURED is the important one. With no provider set up the
  /// message is still written down and still visible, labelled as never
  /// having left — a queue that silently drops messages looks exactly like
  /// a queue where nobody replies.
  status     String  @default("PENDING")
  failReason String?

  /// What we made of an inbound one: SAME · CHANGED · STOP · YES · NO ·
  /// UNCLEAR. Null on anything outbound.
  read String?

  /// The outbound message this answers.
  replyToId String?
  replyTo   TextMessage?  @relation("replies", fields: [replyToId], references: [id])
  replies   TextMessage[] @relation("replies")

  /// What it is about, where it is about something: SUBMISSION · LISTING.
  aboutType String?
  aboutId   String?

  at DateTime @default(now())

  @@index([companyId, at])
  @@index([personId, at])
  @@index([replyToId])
  @@index([companyId, kind, status])
}
